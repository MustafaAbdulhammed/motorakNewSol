@using Motorak.BLL.ModelVM.Mechanic;
@model List<MechanicListModel>
@{
    ViewData["Title"] = "Mechanic Management";
    Layout = "_MotorakIndex";
}

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.4.0/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Manage.css">
</head>
<body>
    <!-- Display Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="notification show" style="background: var(--success-color);">
            <div class="notification-content">
                <i class="ri-check-line"></i>
                <span>@TempData["Success"]</span>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="notification show" style="background: var(--error-color);">
            <div class="notification-content">
                <i class="ri-close-circle-line"></i>
                <span>@TempData["Error"]</span>
            </div>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="notification show" style="background: var(--info-color);">
            <div class="notification-content">
                <i class="ri-information-line"></i>
                <span>@TempData["Info"]</span>
            </div>
        </div>
    }

    <!-- Mechanic Index View -->
    <section class="customers-section">
        <div class="container">
            <!-- Header -->
            <div class="section-header">
                <div class="header-content">
                    <h1 class="section-title">
                        <i class="ri-tools-line"></i>
                        Mechanic Management
                    </h1>
                    <p class="section-subtitle">Manage your mechanics efficiently</p>
                </div>
                <div class="header-actions">
                    <div class="search-container">
                        <input type="text" id="searchInput" placeholder="Search mechanics..." class="search-input">
                        <i class="ri-search-line search-icon"></i>
                    </div>
                    <a href="/Mechanic/Create" class="btn-primary">
                        <i class="ri-add-line"></i>
                        Add New Mechanic
                    </a>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon total">
                        <i class="ri-tools-line"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number">@Model.Count</h3>
                        <p class="stat-label">Total Mechanics</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon active">
                        <i class="ri-user-check-line"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number">@Model.Count(m => !m.IsDeleted)</h3>
                        <p class="stat-label">Active Mechanics</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon new">
                        <i class="ri-user-add-line"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number">@Model.Count(m => m.CreatedAt.Date == DateTime.Today)</h3>
                        <p class="stat-label">New Today</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon purchases">
                        <i class="ri-star-line"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number">@(Model.Any() ? Model.Average(m => m.Rating).ToString("F1") : "0.0")</h3>
                        <p class="stat-label">Average Rating</p>
                    </div>
                </div>
            </div>

            @if (Model.Any())
            {
                <div class="customers-grid" id="mechanicsGrid">
                    @foreach (var mechanic in Model)
                    {
                        <div class="customer-card" data-mechanic-id="@mechanic.Id">
                            <div class="card-header">
                                <div class="customer-avatar">
                                    @mechanic.Name.First().ToString().ToUpper()
                                </div>
                                <div class="customer-info">
                                    <h3 class="customer-name">@mechanic.Name</h3>
                                    <p class="customer-email">@mechanic.Email</p>
                                </div>
                                <div class="customer-status @(mechanic.IsDeleted ? "deleted" : "active")">
                                    <i class="@(mechanic.IsDeleted ? "ri-close-circle-line" : "ri-check-circle-line")"></i>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="info-grid">
                                    <div class="info-item">
                                        <i class="ri-phone-line"></i>
                                        <span>@(mechanic.PhoneNumber ?? "No phone")</span>
                                    </div>
                                    <div class="info-item">
                                        <i class="ri-star-line"></i>
                                        <span>@mechanic.Rating ⭐</span>
                                    </div>
                                    <div class="info-item">
                                        <i class="ri-time-line"></i>
                                        <span>@mechanic.WorkHours</span>
                                    </div>
                                    <div class="info-item">
                                        <i class="ri-calendar-line"></i>
                                        <span>@mechanic.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    </div>
                                    @if (mechanic.IsUpdated)
                                    {
                                        <div class="info-item">
                                            <i class="ri-edit-line"></i>
                                            <span>Updated @mechanic.UpdatedAt.ToString("MMM dd, yyyy")</span>
                                        </div>
                                    }
                                    @if (mechanic.IsDeleted)
                                    {
                                        <div class="info-item">
                                            <i class="ri-delete-bin-line"></i>
                                            <span>Deleted @mechanic.DeletedAt?.ToString("MMM dd, yyyy")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="card-actions">
                                <button class="action-btn view-btn" onclick="viewMechanic('@mechanic.Id')">
                                    <i class="ri-eye-line"></i> View
                                </button>
                                @if (!mechanic.IsDeleted)
                                {
                                    <button class="action-btn edit-btn" onclick="editMechanic('@mechanic.Id')">
                                        <i class="ri-edit-line"></i> Edit
                                    </button>
                                    <button class="action-btn delete-btn" onclick="deleteMechanic('@mechanic.Id')">
                                        <i class="ri-delete-bin-line"></i> Delete
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="no-customers-message" style="text-align: center; padding: 3rem; background: rgba(255,255,255,0.1); border-radius: 1rem; backdrop-filter: blur(10px);">
                    <i class="ri-tools-line" style="font-size: 3rem; color: rgba(255,255,255,0.5); margin-bottom: 1rem;"></i>
                    <h3 style="color: white; margin-bottom: 1rem;">No Mechanics Found</h3>
                    <p style="color: rgba(255,255,255,0.7); margin-bottom: 2rem;">Start by adding your first mechanic to the system.</p>
                    <a href="/Mechanic/Create" class="btn-primary">
                        <i class="ri-add-line"></i>
                        Add First Mechanic
                    </a>
                </div>
            }
        </div>
    </section>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="ri-error-warning-line"></i> Confirm Deletion</h3>
                <span class="close" onclick="closeDeleteModal()">&times;</span>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this mechanic? This action will mark the mechanic as deleted but can be restored later.</p>
                <div class="modal-actions">
                    <button class="btn-secondary" onclick="closeDeleteModal()">Cancel</button>
                    <button class="btn-danger" id="confirmDeleteBtn">Delete Mechanic</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Notification -->
    <div id="notification" class="notification">
        <div class="notification-content">
            <i class="ri-check-line"></i>
            <span id="notification-message">Success!</span>
        </div>
    </div>

    <!-- Anti-forgery token for AJAX requests -->
    @Html.AntiForgeryToken()

    @section Scripts {
        <script src="~/js/MechManage/common.js"></script>
        <script src="~/js/MechManage/list.js"></script>
    }

</body>
</html>