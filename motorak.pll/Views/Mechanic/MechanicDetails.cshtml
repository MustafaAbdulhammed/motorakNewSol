@using Motorak.BLL.ModelVM.Mechanic
@model MechanicDetailsModel
@{
    ViewData["Title"] = "Mechanic Details";
    Layout = "_MotorakIndex";
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.4.0/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Manage.css">
</head>

<body>
    <section class="customers-section">
        <div class="container">
            <!-- Header -->
            <div class="section-header">
                <div class="header-content">
                    <h1 class="section-title">
                        <i class="ri-tools-line"></i>
                        Mechanic Details
                    </h1>
                    <p class="section-subtitle">View detailed information about @Model.Name</p>
                </div>
                <div class="header-actions">
                    <a asp-action="Index" class="btn-secondary">
                        <i class="ri-arrow-left-line"></i>
                        Back to List
                    </a>
                    @if (!Model.IsDeleted)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-primary">
                            <i class="ri-edit-line"></i>
                            Edit Mechanic
                        </a>
                    }
                </div>
            </div>

            <!-- Mechanic Profile Card -->
            <div class="customer-card" style="max-width: 800px; margin: 0 auto;">
                <div class="card-header">
                    <div class="customer-avatar" style="width: 60px; height: 60px; font-size: 1.5rem;">
                        @Model.Name.First().ToString().ToUpper()
                    </div>
                    <div class="customer-info">
                        <h3 class="customer-name" style="font-size: 1.5rem;">@Model.Name</h3>
                        <p class="customer-email" style="font-size: 1rem;">@Model.Email</p>

                        <!-- Status Badges -->
                        @if (Model.IsDeleted)
                        {
                            <div class="status-badge status-deleted">
                                <i class="ri-close-circle-line"></i>
                                Deleted Account
                            </div>
                        }
                        else
                        {
                            <div class="status-badge status-active">
                                <i class="ri-check-circle-line"></i>
                                Active Account
                            </div>
                        }

                        @if (Model.IsUpdated)
                        {
                            <div class="status-badge status-updated">
                                <i class="ri-edit-line"></i>
                                Recently Updated
                            </div>
                        }
                    </div>
                </div>

                <div class="card-content">
                    <!-- Details Grid -->
                    <div class="details-grid">
                        <!-- Contact Information -->
                        <div class="detail-section">
                            <div class="detail-title">
                                <i class="ri-contacts-line"></i>
                                Contact Information
                            </div>
                            <div class="info-item">
                                <i class="ri-mail-line"></i>
                                <div>
                                    <strong>Email:</strong><br>
                                    <span class="detail-value">@Model.Email</span>
                                </div>
                            </div>
                            <div class="info-item">
                                <i class="ri-phone-line"></i>
                                <div>
                                    <strong>Phone:</strong><br>
                                    <span class="detail-value">@(Model.PhoneNumber ?? "Not provided")</span>
                                </div>
                            </div>
                        </div>

                        <!-- Work Information -->
                        <div class="detail-section">
                            <div class="detail-title">
                                <i class="ri-tools-line"></i>
                                Work Information
                            </div>
                            <div class="info-item">
                                <i class="ri-time-line"></i>
                                <div>
                                    <strong>Work Hours:</strong><br>
                                    <span class="detail-value">@Model.WorkHours</span>
                                </div>
                            </div>
                            <div class="info-item">
                                <i class="ri-star-line"></i>
                                <div>
                                    <strong>Rating:</strong><br>
                                    <span class="detail-value">@Model.Rating ⭐</span>
                                </div>
                            </div>
                            <div class="info-item">
                                <i class="ri-shield-check-line"></i>
                                <div>
                                    <strong>Status:</strong><br>
                                    <span class="detail-value">@Model.Status</span>
                                </div>
                            </div>
                            <div class="info-item">
                                <i class="ri-hashtag"></i>
                                <div>
                                    <strong>Mechanic ID:</strong><br>
                                    <span class="detail-value">#@Model.Id</span>
                                </div>
                            </div>
                        </div>

                        <!-- Account Timeline -->
                        <div class="detail-section">
                            <div class="detail-title">
                                <i class="ri-time-line"></i>
                                Account Timeline
                            </div>
                            <div class="info-item">
                                <i class="ri-calendar-line"></i>
                                <div>
                                    <strong>Created:</strong><br>
                                    <span class="detail-value">@Model.CreatedAt.ToString("MMMM dd, yyyy 'at' hh:mm tt")</span>
                                </div>
                            </div>
                            @if (Model.IsUpdated)
                            {
                                <div class="info-item">
                                    <i class="ri-edit-line"></i>
                                    <div>
                                        <strong>Last Updated:</strong><br>
                                        <span class="detail-value">@Model.UpdatedAt.ToString("MMMM dd, yyyy 'at' hh:mm tt")</span>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Account Status -->
                        <div class="detail-section">
                            <div class="detail-title">
                                <i class="ri-shield-user-line"></i>
                                Account Status
                            </div>
                            <div class="info-item">
                                <i class="ri-checkbox-circle-line"></i>
                                <div>
                                    <strong>Status:</strong><br>
                                    <span class="detail-value">@(Model.IsDeleted ? "Deleted" : "Active")</span>
                                </div>
                            </div>
                            @if (Model.IsDeleted && Model.DeletedAt.HasValue)
                            {
                                <div class="info-item">
                                    <i class="ri-delete-bin-line"></i>
                                    <div>
                                        <strong>Deleted On:</strong><br>
                                        <span class="detail-value">@Model.DeletedAt.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="card-actions" style="justify-content: center; gap: 1rem;">
                    <a asp-action="Index" class="action-btn view-btn">
                        <i class="ri-list-check"></i> Back to List
                    </a>
                    @if (!Model.IsDeleted)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="action-btn edit-btn">
                            <i class="ri-edit-line"></i> Edit Mechanic
                        </a>
                        <button class="action-btn delete-btn" onclick="deleteMechanic(@Model.Id)">
                            <i class="ri-delete-bin-line"></i> Delete Mechanic
                        </button>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3><i class="ri-error-warning-line"></i> Confirm Deletion</h3>
                <span class="close" onclick="closeDeleteModal()">&times;</span>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong>@Model.Name</strong>? This action will mark the mechanic as deleted but can be restored later.</p>
                <div class="modal-actions">
                    <button class="btn-secondary" onclick="closeDeleteModal()">Cancel</button>
                    <button class="btn-danger" id="confirmDeleteBtn">Delete Mechanic</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Notification -->
    <div id="notification" class="notification">
        <div class="notification-content">
            <i class="ri-check-line"></i>
            <span id="notification-message">Success!</span>
        </div>
    </div>

    <!-- Anti-forgery token for AJAX requests -->
    @Html.AntiForgeryToken()

    @section Scripts {
        <script src="~/js/MechManage/common.js"></script>
        <script src="~/js/MechManage/details.js"></script>
    }

</body>