@using Motorak.BLL.ModelVM.Rents
@model RentReadDto

@{
    ViewData["Title"] = "Rental Details";
    Layout = "_MotorakIndex";
    var duration = (Model.EndDate - Model.StartDate).Days;
}

<style>
    .details-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 0;
    }

    .glass-card {
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(251, 191, 36, 0.2);
        border-radius: 32px;
        overflow: hidden;
        width: 100%;
        max-width: 800px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .card-header-custom {
        padding: 3rem;
        background: linear-gradient(to bottom, rgba(251, 191, 36, 0.05), transparent);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        text-align: center;
    }

    .status-pill {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        border-radius: 50px;
        font-weight: 800;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 1rem;
        border: 1px solid var(--gold);
        color: var(--gold);
        background: rgba(251, 191, 36, 0.1);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
        padding: 3rem;
    }

    .info-item {
        border-left: 2px solid rgba(251, 191, 36, 0.3);
        padding-left: 1.5rem;
    }

    .info-label {
        color: #94a3b8;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .info-value {
        color: white;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .price-footer {
        background: rgba(0, 0, 0, 0.3);
        padding: 2rem 3rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .total-label {
        color: #94a3b8;
        font-weight: 700;
    }

    .total-amount {
        color: var(--gold);
        font-size: 2rem;
        font-weight: 900;
    }

    .btn-group-custom {
        padding: 2rem 3rem;
        display: flex;
        gap: 1rem;
    }

    .btn-gold {
        background: var(--gold);
        color: #000 !important;
        font-weight: 800;
        border-radius: 14px;
        padding: 0.8rem 2rem;
        flex: 1;
        text-align: center;
        text-decoration: none;
        transition: 0.3s;
    }

    .btn-outline {
        border: 1px solid rgba(255,255,255,0.2);
        color: white !important;
        font-weight: 700;
        border-radius: 14px;
        padding: 0.8rem 2rem;
        flex: 1;
        text-align: center;
        text-decoration: none;
    }

    .btn-gold:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(251,191,36,0.3);
    }
</style>

<div class="details-container">
    <div class="glass-card">
        <div class="card-header-custom">
            <div class="status-pill">@Model.Status</div>
            <h1 class="page-title" style="font-size: 2.2rem; margin-bottom: 0;">Rental Agreement</h1>
            <p class="text-muted">Transaction ID: #@Model.Id.ToString("D5")</p>
        </div>

        <div class="info-grid">
            <div class="info-item">
                <div class="info-label">Customer Reference</div>
                <div class="info-value">#@Model.CustomerId</div>
            </div>
            <div class="info-item">
                <div class="info-label">Vehicle Reference</div>
                <div class="info-value">#@Model.CarId</div>
            </div>
            <div class="info-item">
                <div class="info-label">Start Date</div>
                <div class="info-value">@Model.StartDate.ToString("MMM dd, yyyy")</div>
            </div>
            <div class="info-item">
                <div class="info-label">End Date</div>
                <div class="info-value">@Model.EndDate.ToString("MMM dd, yyyy")</div>
            </div>
            <div class="info-item">
                <div class="info-label">Duration</div>
                <div class="info-value">@duration Days</div>
            </div>
            <div class="info-item">
                <div class="info-label">Payment Method</div>
                <div class="info-value">@Model.PaymentMethod</div>
            </div>
        </div>

        <div class="price-footer">
            <span class="total-label">FINAL SETTLEMENT</span>
            <span class="total-amount">$@Model.TotalPrice.ToString("N0")</span>
        </div>

        <div class="btn-group-custom">
            <a asp-action="Index" class="btn-outline">Return to Fleet</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-gold">Modify Agreement</a>
        </div>
    </div>
</div>