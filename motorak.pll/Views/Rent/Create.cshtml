@using Motorak.BLL.ModelVM.Rents
@model RentCreateDto

@{
    ViewData["Title"] = "Create Rental";
    Layout = "_MotorakIndex";
}

<style>
    :root {
        --accent: #38bdf8;
        --accent-dim: rgba(56, 189, 248, 0.12);
        --accent-border: rgba(56, 189, 248, 0.3);
    }

    .rent-form-page {
        min-height: 100vh;
        padding: 2rem 0 5rem;
        position: relative;
    }

        /* Background Gradients */
        .rent-form-page::before {
            content: '';
            position: fixed;
            inset: 0;
            background: radial-gradient(ellipse at 20% 30%, rgba(56,189,248,0.07) 0%, transparent 55%), radial-gradient(ellipse at 80% 70%, rgba(99,102,241,0.07) 0%, transparent 55%);
            pointer-events: none;
            z-index: -1;
        }

        .rent-form-page::after {
            content: '';
            position: fixed;
            inset: 0;
            background-image: linear-gradient(rgba(56,189,248,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(56,189,248,0.025) 1px, transparent 1px);
            background-size: 55px 55px;
            pointer-events: none;
            z-index: -1;
        }

    .container {
        max-width: 780px;
        margin: 0 auto;
        padding: 0 1.5rem;
        position: relative;
        z-index: 1;
    }

    /* Header Styling */
    .form-header {
        text-align: center;
        padding: 3rem 0 2.5rem;
        opacity: 0;
        animation: slideDown 0.9s cubic-bezier(0.23,1,0.32,1) forwards;
    }

    .form-icon-wrap {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 72px;
        height: 72px;
        border-radius: 22px;
        background: linear-gradient(135deg, rgba(56,189,248,0.2), rgba(56,189,248,0.05));
        border: 1px solid var(--accent-border);
        font-size: 2rem;
        margin-bottom: 1.2rem;
        box-shadow: 0 0 35px rgba(56,189,248,0.15);
    }

    .form-title {
        font-family: 'Exo 2', 'Segoe UI', sans-serif;
        font-size: 2.8rem;
        font-weight: 900;
        background: linear-gradient(135deg, #fff 0%, #bae6fd 40%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: -0.5px;
    }

    .form-subtitle {
        color: rgba(186,230,253,0.55);
        font-size: 1rem;
        margin-top: 0.4rem;
    }

    /* Card Styling */
    .form-card {
        background: rgba(10, 18, 35, 0.9);
        backdrop-filter: blur(28px);
        border: 1px solid rgba(56,189,248,0.2);
        border-radius: 28px;
        padding: 2.8rem;
        box-shadow: 0 30px 60px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.05);
        position: relative;
        overflow: hidden;
        opacity: 0;
        transform: translateY(30px) scale(0.97);
        animation: cardIn 0.8s 0.35s cubic-bezier(0.34,1.56,0.64,1) forwards;
    }

        .form-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #0ea5e9, #38bdf8, #818cf8, #38bdf8, #0ea5e9);
            background-size: 200% 100%;
            animation: shimmerBar 3s linear infinite;
        }

    @@keyframes shimmerBar {
        0% {
            background-position: -200% 0;
        }

        100% {
            background-position: 200% 0;
        }
    }

    @@keyframes cardIn {
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .form-section {
        background: rgba(56,189,248,0.04);
        border: 1px solid rgba(56,189,248,0.12);
        border-radius: 18px;
        padding: 1.8rem;
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1rem;
        font-weight: 700;
        color: rgba(186,230,253,0.85);
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 1.5rem;
    }

        .section-title i {
            color: var(--accent);
        }

    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.2rem;
    }

    @@media (max-width: 600px) {
        .field-row {
            grid-template-columns: 1fr;
        }
    }

    .field-group {
        margin-bottom: 1.2rem;
    }

    .field-label {
        display: block;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        color: rgba(186,230,253,0.6);
        margin-bottom: 0.6rem;
    }

    .field-input, .field-select {
        width: 100%;
        background: rgba(0,0,0,0.35);
        border: 2px solid rgba(56,189,248,0.18);
        border-radius: 14px;
        color: royalblue;
        padding: 14px 16px;
        transition: all 0.35s cubic-bezier(0.4,0,0.2,1);
        outline: none;
    }

        .field-input:focus, .field-select:focus {
            border-color: var(--accent);
            background: rgba(56,189,248,0.07);
            box-shadow: 0 0 0 3px rgba(56,189,248,0.12);
        }

        .field-input:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            background: rgba(255,255,255,0.05);
        }

    .field-error {
        color: #f87171;
        font-size: 0.8rem;
        margin-top: 6px;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(56,189,248,0.1);
    }

    .btn-submit {
        flex: 1;
        padding: 15px;
        background: linear-gradient(135deg, #0369a1, #0ea5e9, #38bdf8);
        border: none;
        border-radius: 16px;
        color: white;
        font-weight: 700;
        cursor: pointer;
        transition: 0.4s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(14,165,233,0.5);
        }

    .btn-back {
        padding: 15px 28px;
        background: rgba(56,189,248,0.08);
        border: 1px solid var(--accent-border);
        border-radius: 16px;
        color: var(--accent);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: 0.3s;
    }

    .val-summary {
        background: rgba(244,63,94,0.1);
        border: 1px solid rgba(244,63,94,0.3);
        border-radius: 16px;
        padding: 1.2rem;
        margin-bottom: 1.5rem;
        color: #fda4af;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@300;600;700;900&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="rent-form-page">
    <div class="container">

        <div class="form-header">
            <div class="form-icon-wrap">🚗</div>
            <h1 class="form-title">New Rental</h1>
            <p class="form-subtitle">Fill in the details to create a rental agreement</p>
        </div>

        <div class="form-card">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="val-summary">
                    <strong><i class="bi bi-exclamation-triangle me-2"></i>Please fix the errors below:</strong>
                    <div asp-validation-summary="All" class="mt-2"></div>
                </div>
            }

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="form-section">
                    <div class="section-title">
                        <i class="bi bi-calendar-range-fill"></i> Rental Period
                    </div>
                    <div class="field-row">
                        <div class="field-group">
                            <label class="field-label" asp-for="StartDate">Start Date</label>
                            <input type="date" class="field-input" asp-for="StartDate" id="StartDate"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="StartDate" class="field-error"></span>
                        </div>
                        <div class="field-group">
                            <label class="field-label" asp-for="EndDate">End Date</label>
                            <input type="date" class="field-input" asp-for="EndDate" id="EndDate"
                                   min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="EndDate" class="field-error"></span>
                        </div>
                    </div>

                    <div id="daysDisplay" style="display:none; margin-top:0.5rem;">
                        <span class="days-badge" style="background:rgba(56,189,248,0.12);border:1px solid rgba(56,189,248,0.25);border-radius:20px;padding:6px 14px;font-size:0.85rem;color:#38bdf8;font-weight:600;">
                            <i class="bi bi-clock"></i>&nbsp; <span id="daysCount">0</span> day(s) rental
                        </span>
                    </div>
                </div>

                <div class="form-section">
                    <div class="section-title"><i class="bi bi-link-45deg"></i> Assignment</div>
                    <div class="field-row">
                        @* --- Customer Selection --- *@
                        <div class="field-group">
                            <label class="field-label" asp-for="CustomerId">Customer</label>
                            @if (User.IsInRole("Admin"))
                            {
                                <select class="field-select" asp-for="CustomerId" asp-items="@(ViewBag.Customers as SelectList)">
                                    <option value="">— Select customer —</option>
                                </select>
                            }
                            else
                            {
                                <input type="hidden" asp-for="CustomerId" />
                                <input type="text" class="field-input" value="@(ViewBag.Customers is SelectList customers ? customers.FirstOrDefault(c => c.Value == Model?.CustomerId.ToString())?.Text : "Current user")" readonly disabled />
                            }
                            <span asp-validation-for="CustomerId" class="field-error"></span>
                        </div>

                        @* --- Car Selection --- *@
                        <div class="field-group">
                            <label class="field-label" asp-for="CarId">Car</label>
                            @if (Model?.CarId > 0)
                            {
                                <input type="hidden" asp-for="CarId" />
                                <input type="text" class="field-input" value="@(ViewBag.CarDisplay ?? $"Car #{Model.CarId}")" readonly disabled />
                            }
                            else
                            {
                                <input type="number" class="field-input" asp-for="CarId" placeholder="Enter Car ID" min="1" />
                            }
                            <span asp-validation-for="CarId" class="field-error"></span>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="section-title">
                        <i class="bi bi-credit-card-2-front-fill"></i> Payment Details
                    </div>
                    <div class="field-row">
                        <div class="field-group">
                            <label class="field-label" asp-for="PaymentMethod">Payment Method</label>
                            <select class="field-select" asp-for="PaymentMethod">
                                <option value="">— Select method —</option>
                                <option value="Credit Card">Credit Card</option>
                                <option value="Cash">Cash</option>
                                <option value="Online">Online Payment</option>
                            </select>
                            <span asp-validation-for="PaymentMethod" class="field-error"></span>
                        </div>
                        <div class="field-group">
                            <label class="field-label" asp-for="TotalPrice">Total Price ($)</label>
                            <input type="number" step="0.01" class="field-input" asp-for="TotalPrice" placeholder="0.00" />
                            <span asp-validation-for="TotalPrice" class="field-error"></span>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <a asp-action="Index" class="btn-back">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                    <button type="submit" class="btn-submit">
                        <i class="bi bi-check-circle-fill"></i> Create Rental
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const startInput = document.getElementById('StartDate');
            const endInput = document.getElementById('EndDate');
            const daysDisplay = document.getElementById('daysDisplay');
            const daysCount = document.getElementById('daysCount');

            function updateDays() {
                if (startInput.value && endInput.value) {
                    const s = new Date(startInput.value);
                    const e = new Date(endInput.value);
                    if (e > s) {
                        const diff = Math.ceil((e - s) / (1000 * 60 * 60 * 24));
                        daysCount.textContent = diff;
                        daysDisplay.style.display = 'block';
                    } else {
                        daysDisplay.style.display = 'none';
                    }
                }
            }

            startInput?.addEventListener('change', function() {
                if (this.value) {
                    let minDate = new Date(this.value);
                    minDate.setDate(minDate.getDate() + 1);
                    endInput.min = minDate.toISOString().split('T')[0];

                    if (endInput.value && new Date(endInput.value) <= new Date(this.value)) {
                        endInput.value = endInput.min;
                    }
                }
                updateDays();
            });

            endInput?.addEventListener('change', updateDays);
            updateDays(); // Initial check
        });
    </script>
}