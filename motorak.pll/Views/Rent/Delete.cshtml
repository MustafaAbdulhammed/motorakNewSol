@using Motorak.BLL.ModelVM.Rents
@using Motorak.DAL.Enums.TransactionEnums
@model RentReadDto

@{
    ViewData["Title"] = "Terminate Agreement";
    Layout = "_MotorakIndex";
}

<style>
    :root {
        --danger: #ef4444;
        --danger-bright: #f87171;
        --glass-dark: rgba(10, 15, 26, 0.98);
    }

    .delete-wrapper {
        min-height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: radial-gradient(circle at bottom left, rgba(239, 68, 68, 0.1), transparent 600px);
    }

    .luxury-delete-card {
        background: var(--glass-dark);
        backdrop-filter: blur(25px);
        border: 2px solid rgba(239, 68, 68, 0.3);
        border-radius: 40px;
        padding: 4rem;
        width: 100%;
        max-width: 600px;
        box-shadow: 0 40px 80px rgba(0, 0, 0, 0.8);
        text-align: center;
    }

    .danger-icon-wrapper {
        width: 100px;
        height: 100px;
        background: rgba(239, 68, 68, 0.1);
        border: 2px solid var(--danger);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
        color: var(--danger-bright);
        font-size: 3rem;
        animation: pulse-danger 2s infinite;
    }

    @@keyframes pulse-danger {
        0% {
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4);
        }

        70% {
            box-shadow: 0 0 0 20px rgba(239, 68, 68, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
        }
    }

    .summary-box {
        background: rgba(255, 255, 255, 0.03);
        border-radius: 20px;
        padding: 1.5rem;
        margin: 2rem 0;
        border: 1px solid rgba(255, 255, 255, 0.1);
        text-align: left;
    }

    .summary-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .summary-label {
        color: #94a3b8;
    }

    .summary-value {
        color: #f8fafc;
        font-weight: 600;
    }

    .btn-delete-confirm {
        background: linear-gradient(135deg, #ef4444 0%, #991b1b 100%);
        color: white !important;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        border-radius: 16px;
        padding: 1.2rem;
        border: none;
        width: 100%;
        transition: 0.3s;
        cursor: pointer;
        box-shadow: 0 10px 20px rgba(239, 68, 68, 0.2);
    }

        .btn-delete-confirm:hover {
            transform: translateY(-3px);
            filter: brightness(1.2);
            box-shadow: 0 15px 30px rgba(239, 68, 68, 0.4);
        }

    .btn-cancel-link {
        display: block;
        margin-top: 1.5rem;
        color: #94a3b8;
        text-decoration: none;
        font-weight: 700;
        transition: 0.3s;
    }

        .btn-cancel-link:hover {
            color: white;
        }
</style>

<div class="delete-wrapper">
    <div class="luxury-delete-card">
        <div class="danger-icon-wrapper">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>

        <h1 class="fw-900 text-white mb-2" style="font-size: 2rem;">Confirm Deletion</h1>
        <p class="text-muted">Agreement <b class="text-danger">#@Model.Id</b> will be permanently removed from the system.</p>

        <div class="summary-box">
            <div class="summary-item">
                <span class="summary-label">Total Amount</span>
                <span class="summary-value text-danger">$@Model.TotalPrice.ToString("N2")</span>
            </div>
            <div class="summary-item">
                <span class="summary-label">Customer ID</span>
                <span class="summary-value">#@Model.CustomerId</span>
            </div>
            <div class="summary-item">
                <span class="summary-label">Payment Method</span>
                <span class="summary-value">@Model.PaymentMethod</span>
            </div>
            <div class="summary-item">
                <span class="summary-label">Status</span>
                <span class="summary-value">@Model.Status</span>
            </div>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-delete-confirm">
                Confirm Destruction
            </button>
            <a asp-action="Index" class="btn-cancel-link">Keep this Record</a>
        </form>
    </div>
</div>