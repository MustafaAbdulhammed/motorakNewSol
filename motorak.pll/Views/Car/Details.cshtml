@using Motorak.BLL.ModelVM.Car;
@using Motorak.DAL.Enums.CarEnums;
@using motorak.dal.Enums.CarEnums
@model CarDetailsModel

@{
    ViewData["Title"] = $"{Model.Brand} {Model.Model} - Details";
    Layout = "_MotorakIndex";
}

<style>
    :root {
        --gold: #fbbf24;
        --gold-hover: #f59e0b;
        --dark-card: rgba(10, 18, 35, 0.85);
        --glass-border: rgba(251, 191, 36, 0.2);
    }

    .car-details-page {
        padding: 40px 0;
        color: #e2e8f0;
    }

    /* Hero Title Section */
    .vehicle-header {
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--glass-border);
    }

    .vehicle-title {
        font-size: 2.5rem;
        font-weight: 800;
        background: linear-gradient(to right, #fff, var(--gold));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* Main Container Styles */
    .glass-card {
        background: var(--dark-card);
        backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        margin-bottom: 24px;
        transition: border-color 0.3s ease;
    }

        .glass-card:hover {
            border-color: rgba(251, 191, 36, 0.4);
        }

    /* Image Styling */
    .main-image-wrapper {
        position: relative;
        border-radius: 24px;
        overflow: hidden;
        height: 500px;
    }

    .main-car-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .main-image-wrapper:hover .main-car-img {
        transform: scale(1.05);
    }

    /* Quick Specs Bar */
    .quick-specs {
        display: flex;
        justify-content: space-around;
        padding: 20px;
        background: rgba(251, 191, 36, 0.05);
        border-top: 1px solid var(--glass-border);
    }

    .spec-item {
        text-align: center;
    }

        .spec-item i {
            color: var(--gold);
            font-size: 1.5rem;
            display: block;
            margin-bottom: 5px;
        }

        .spec-item span {
            font-size: 0.8rem;
            text-transform: uppercase;
            color: #94a3b8;
        }

        .spec-item p {
            margin: 0;
            font-weight: 700;
        }

    /* --- NEW ACTION TILES STYLES --- */
    .action-tile {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(251, 191, 36, 0.1);
        border-radius: 16px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 15px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        margin-bottom: 12px;
    }

        .action-tile:hover {
            background: rgba(251, 191, 36, 0.08);
            border-color: var(--gold);
            transform: translateX(5px);
        }

    .tile-icon {
        width: 45px;
        height: 45px;
        background: rgba(251, 191, 36, 0.1);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: var(--gold);
    }

    .tile-label {
        display: block;
        font-size: 0.7rem;
        color: #94a3b8;
        font-weight: 600;
        text-transform: uppercase;
    }

    .tile-price {
        font-size: 1.2rem;
        font-weight: 800;
        color: #fff;
    }

        .tile-price small {
            font-size: 0.75rem;
            color: #94a3b8;
            font-weight: 400;
        }

    .btn-sec-action {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.1);
        color: #e2e8f0;
        padding: 10px;
        border-radius: 10px;
        font-size: 0.8rem;
        transition: all 0.2s;
    }

        .btn-sec-action:hover {
            border-color: var(--gold);
            color: var(--gold);
        }

    /* Table Styling */
    .info-table {
        width: 100%;
    }

        .info-table td {
            padding: 12px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .info-table .label {
            color: #94a3b8;
            font-weight: 500;
        }

        .info-table .value {
            text-align: right;
            font-weight: 600;
        }

    .sticky-box {
        position: sticky;
        top: 100px;
    }
</style>

<div class="car-details-page">
    <div class="container">

        <div class="vehicle-header d-flex justify-content-between align-items-end">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb" style="background:transparent; padding:0;">
                        <li class="breadcrumb-item"><a href="/Car" class="text-gold">Inventory</a></li>
                        <li class="breadcrumb-item active text-white">@Model.Brand</li>
                    </ol>
                </nav>
                <h1 class="vehicle-title">@Model.Brand @Model.Model</h1>
                <div class="d-flex gap-2 mt-2">
                    <span class="badge" style="background: rgba(59,130,246,0.1); color: #60a5fa; border: 1px solid #3b82f6;">@Model.Year</span>
                    <span class="badge" style="background: rgba(16,185,129,0.1); color: #34d399; border: 1px solid #10b981;">@Model.Condition</span>
                </div>
            </div>
            <div class="text-end">
                <span class="text-muted d-block small">LISTING ID: #MT-@Model.Id.ToString("D4")</span>
                <span class="text-white"><i class="ri-map-pin-2-line text-gold"></i> Cairo, Giza</span>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="glass-card overflow-hidden">
                    <div class="main-image-wrapper">
                        <img src="@(Model.ImagePath ?? "/assets/img/default-car.png")" class="main-car-img" alt="Vehicle Image">
                    </div>

                    <div class="quick-specs">
                        <div class="spec-item">
                            <i class="ri-dashboard-3-line"></i>
                            <span>Mileage</span>
                            <p>@Model.Mileage.ToString("N0") km</p>
                        </div>
                        <div class="spec-item">
                            <i class="ri-settings-5-line"></i>
                            <span>Transmission</span>
                            <p>@Model.Transmission</p>
                        </div>
                        <div class="spec-item">
                            <i class="ri-gas-station-fill"></i>
                            <span>Fuel</span>
                            <p>Petrol</p>
                        </div>
                        <div class="spec-item">
                            <i class="ri-palette-line"></i>
                            <span>Color</span>
                            <p>@Model.Color</p>
                        </div>
                    </div>
                </div>

                <div class="glass-card p-4">
                    <h4 class="text-gold mb-4"><i class="ri-information-fill"></i> Vehicle Specifications</h4>
                    <div class="row">
                        <div class="col-md-6">
                            <table class="info-table">
                                <tr><td class="label">Body Type</td><td class="value">@Model.Type</td></tr>
                                <tr><td class="label">Engine Size</td><td class="value">2.0L Turbo</td></tr>
                                <tr><td class="label">Doors</td><td class="value">4 Doors</td></tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="info-table">
                                <tr><td class="label">Interior Color</td><td class="value">Premium Black</td></tr>
                                <tr><td class="label">Drive Type</td><td class="value">AWD</td></tr>
                                <tr><td class="label">Status</td><td class="value text-success">@Model.Status</td></tr>
                            </table>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <div class="sticky-box">
                    <div class="glass-card p-4">
                        <h6 class="text-gold mb-4 fw-bold" style="letter-spacing:1px;">TRANSACTION OPTIONS</h6>

                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (Model.Category == CarCategory.ForSale || Model.Category == CarCategory.Both)
                            {
                                <div class="action-tile" onclick="addToCartDirect(@Model.Id, 'Buy')">
                                    <div class="tile-icon"><i class="ri-bank-card-line"></i></div>
                                    <div class="tile-content">
                                        <span class="tile-label">Buy Ownership</span>
                                        <div class="tile-price">$@Model.Price.ToString("N0")</div>
                                    </div>
                                    <i class="ri-arrow-right-s-line text-muted"></i>
                                </div>
                            }

                            @if (Model.Category == CarCategory.ForRent || Model.Category == CarCategory.Both)
                            {
                                <div class="action-tile" onclick="showAddToCartModal(@Model.Id, 'Rent')">
                                    <div class="tile-icon"><i class="ri-calendar-check-line"></i></div>
                                    <div class="tile-content">
                                        <span class="tile-label">Rent per Day</span>
                                        <div class="tile-price">$@(Model.DailyRentPrice?.ToString("N0") ?? "0") <small>/day</small></div>
                                    </div>
                                    <i class="ri-arrow-right-s-line text-muted"></i>
                                </div>
                            }
                        }
                        else
                        {
                            <a href="/Identity/Account/Login" class="btn btn-primary-gold w-100 py-3 fw-bold rounded-pill text-dark text-decoration-none d-block text-center">
                                LOGIN TO VIEW OPTIONS
                            </a>
                        }

                        <div class="d-flex gap-2 mt-3">
                            <button class="btn-sec-action w-50" onclick="addToWishlist(@Model.Id)">
                                <i class="ri-heart-3-line"></i> Save
                            </button>
                            <button class="btn-sec-action w-50" onclick="shareVehicle()">
                                <i class="ri-share-forward-line"></i> Share
                            </button>
                        </div>
                    </div>

                    <div class="glass-card p-3">
                        <div class="d-flex align-items-center gap-3">
                            <div style="background:#10b981; color:white; width:35px; height:35px; border-radius:50%; display:flex; align-items:center; justify-content:center;">
                                <i class="ri-shield-check-line"></i>
                            </div>
                            <div>
                                <p class="mb-0 fw-bold small">Certified Listing</p>
                                <p class="mb-0 text-muted" style="font-size: 11px;">Verified by Motorak Inspection Team</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_AddToCartModal")

@section Scripts {
    <script>
        async function addToCartDirect(carId, type) {
            try {
                const response = await fetch('/Cart/AddToCart', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ carId: carId, itemType: type })
                });
                const result = await response.json();
                alert(result.message);
            } catch (err) {
                alert("Error adding to cart");
            }
        }

        function shareVehicle() {
            navigator.clipboard.writeText(window.location.href);
            alert("Link copied to clipboard!");
        }

        function addToWishlist(id) {
            alert("Added to your wishlist!");
        }
    </script>
}