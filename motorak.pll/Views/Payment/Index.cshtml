<!-- motorak.pll/Views/Payment/Index.cshtml -->
@using motorak.bll.ModelVM.ShoppingCart
@{
    ViewData["Title"] = "Checkout";
    Layout = "_MotorakIndex";
    var cartItems = ViewBag.CartItems as List<ShoppingCartVM> ?? new List<ShoppingCartVM>();
    decimal total = ViewBag.TotalAmount ?? 0m;
}

<style>
    .payment-container {
        max-width: 700px;
        margin: 3rem auto;
        background: var(--container-color);
        border-radius: 1rem;
        padding: 2rem;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }

    .payment-title {
        color: var(--title-color);
        font-size: var(--h2-font-size);
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .order-summary {
        margin-bottom: 2rem;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        color: var(--text-color);
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .summary-total {
        font-weight: bold;
        color: var(--title-color);
        font-size: 1.2rem;
    }

    .payment-form .form-group {
        margin-bottom: 1.5rem;
    }

    .payment-form label {
        display: block;
        color: var(--text-color);
        margin-bottom: 0.5rem;
        font-size: var(--small-font-size);
    }

    .payment-form input, .payment-form select {
        width: 100%;
        padding: 0.75rem 1rem;
        background: var(--body-color);
        border: 2px solid transparent;
        border-radius: 0.5rem;
        color: var(--title-color);
        font-size: var(--normal-font-size);
        transition: border-color 0.3s;
    }

        .payment-form input:focus, .payment-form select:focus {
            outline: none;
            border-color: var(--first-color);
        }

    .btn-pay {
        width: 100%;
        padding: 1rem;
        background: var(--first-color);
        color: var(--white-color);
        border: none;
        border-radius: 0.5rem;
        font-size: var(--normal-font-size);
        font-weight: var(--font-medium);
        cursor: pointer;
        transition: background 0.3s, transform 0.2s;
    }

        .btn-pay:hover {
            background: var(--first-color-alt);
            transform: translateY(-2px);
        }

        .btn-pay:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

    .card-fields {
        display: none;
        margin-top: 1rem;
    }

        .card-fields.show {
            display: block;
        }

    .alert-msg {
        padding: 1rem;
        border-radius: 0.5rem;
        margin-bottom: 1rem;
        display: none;
    }

    .alert-success {
        background: rgba(16,185,129,0.15);
        color: #6ee7b7;
        border: 1px solid rgba(16,185,129,0.3);
    }

    .alert-error {
        background: rgba(239,68,68,0.15);
        color: #fca5a5;
        border: 1px solid rgba(239,68,68,0.3);
    }
</style>

<div class="payment-container">
    <h2 class="payment-title">
        <i class="ri-secure-payment-line" style="color: var(--first-color);"></i>
        Secure Checkout
    </h2>

    <div class="order-summary">
        <h3 style="color: var(--title-color); margin-bottom: 1rem;">Order Summary</h3>
        @foreach (var item in cartItems)
        {
            <div class="summary-row">
                <span>@item.Brand @item.Model (@item.ItemType)</span>
                <span>@item.TotalPrice.ToString("C")</span>
            </div>
        }
        <div class="summary-row summary-total">
            <span>Total</span>
            <span>@total.ToString("C")</span>
        </div>
    </div>

    <div id="alertSuccess" class="alert-msg alert-success">
        <i class="ri-check-circle-line"></i> Payment successful! Redirecting...
    </div>
    <div id="alertError" class="alert-msg alert-error">
        <i class="ri-error-warning-line"></i> <span id="errorMsg"></span>
    </div>

    <div class="payment-form">
        <div class="form-group">
            <label>Payment Method</label>
            <select id="paymentMethod" onchange="toggleCardFields()">
                <option value="Cash">Cash on Delivery</option>
                <option value="CreditCard">Credit Card</option>
                <option value="BankTransfer">Bank Transfer</option>
            </select>
        </div>

        <div class="card-fields" id="cardFields">
            <div class="form-group">
                <label>Card Holder Name</label>
                <input type="text" id="cardHolderName" placeholder="Name on card" />
            </div>
            <div class="form-group">
                <label>Card Number</label>
                <input type="text" id="cardNumber" placeholder="1234 5678 9012 3456" maxlength="16" />
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:1rem;">
                <div class="form-group">
                    <label>Month</label>
                    <input type="text" id="expiryMonth" placeholder="MM" maxlength="2" />
                </div>
                <div class="form-group">
                    <label>Year</label>
                    <input type="text" id="expiryYear" placeholder="YY" maxlength="2" />
                </div>
                <div class="form-group">
                    <label>CVV</label>
                    <input type="text" id="cvv" placeholder="123" maxlength="3" />
                </div>
            </div>
        </div>

        <button class="btn-pay" id="payBtn" onclick="submitPayment()">
            <i class="ri-lock-line"></i> Pay @total.ToString("C")
        </button>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        function toggleCardFields() {
            const method = document.getElementById('paymentMethod').value;
            const fields = document.getElementById('cardFields');
            fields.classList.toggle('show', method === 'CreditCard');
        }

        async function submitPayment() {
            const btn = document.getElementById('payBtn');
            const method = document.getElementById('paymentMethod').value;

            btn.disabled = true;
            btn.innerHTML = '<i class="ri-loader-4-line"></i> Processing...';

            document.getElementById('alertSuccess').style.display = 'none';
            document.getElementById('alertError').style.display = 'none';

            const payload = {
                paymentMethod: method,
                cardNumber: document.getElementById('cardNumber')?.value ?? '',
                expiryMonth: document.getElementById('expiryMonth')?.value ?? '',
                expiryYear: document.getElementById('expiryYear')?.value ?? '',
                cvv: document.getElementById('cvv')?.value ?? '',
                cardHolderName: document.getElementById('cardHolderName')?.value ?? '',
                amount: @total
            };

            try {
                const response = await fetch('/Payment/ProcessPayment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();

                if (result.success) {
                    document.getElementById('alertSuccess').style.display = 'block';
                    setTimeout(() => window.location.href = '/Car/Index', 2000);
                } else {
                    document.getElementById('errorMsg').textContent = result.message;
                    document.getElementById('alertError').style.display = 'block';
                    btn.disabled = false;
                    btn.innerHTML = '<i class="ri-lock-line"></i> Pay @total.ToString("C")';
                }
            } catch (e) {
                document.getElementById('errorMsg').textContent = 'Network error. Please try again.';
                document.getElementById('alertError').style.display = 'block';
                btn.disabled = false;
                btn.innerHTML = '<i class="ri-lock-line"></i> Pay @total.ToString("C")';
            }
        }
    </script>
}