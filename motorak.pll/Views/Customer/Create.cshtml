@using Motorak.BLL.ModelVM.Customer
@model CreateCustomerModel
@{
    ViewData["Title"] = "Create Customer";
    Layout = "_MotorakIndex";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.4.0/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Manage.css">

</head>
<body>
    <section class="customers-section">
        <div class="container">
            <!-- Header -->
            <div class="section-header">
                <div class="header-content">
                    <h1 class="section-title">
                        <i class="ri-user-add-line"></i>
                        Create Customer
                    </h1>
                    <p class="section-subtitle">Add a new customer to the system</p>
                </div>
                <div class="header-actions">
                    <a asp-action="Index" class="btn-secondary">
                        <i class="ri-arrow-left-line"></i>
                        Back to List
                    </a>
                </div>
            </div>

            <!-- Create Customer Form -->
            <div class="form-section">
                <div class="card-header">
                    <div class="customer-avatar">
                        <i class="ri-user-add-line"></i>
                    </div>
                    <div class="customer-info">
                        <h3 class="customer-name">New Customer Registration</h3>
                        <p class="customer-email">Please fill all required fields</p>
                    </div>
                </div>

                <div class="card-content">
                    <form asp-controller="Customer" asp-action="Create" method="post" id="createCustomerForm">
                        @Html.AntiForgeryToken()

                        <!-- Display ModelState errors -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="validation-summary" style="background: rgba(244, 67, 54, 0.1); border: 1px solid var(--error-color); border-radius: var(--border-radius); padding: 1rem; margin-bottom: 1.5rem;">
                                <h4 style="color: var(--error-color); margin-bottom: 0.5rem;">
                                    <i class="ri-error-warning-line"></i> Please correct the following errors:
                                </h4>
                                <ul style="margin: 0; padding-left: 1rem;">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li style="color: var(--error-color); margin-bottom: 0.25rem;">@error.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="info-grid">
                            <div class="info-item @(Html.ViewData.ModelState["Name"]?.Errors.Count > 0 ? "error" : "")">
                                <i class="ri-user-line"></i>
                                <div style="flex: 1;">
                                    <input asp-for="Name" placeholder="Enter Full Name *" class="form-control" />
                                    @if (Html.ViewData.ModelState["Name"]?.Errors.Count > 0)
                                    {
                                        <div class="validation-error">
                                            <i class="ri-error-warning-line"></i>
                                            <span asp-validation-for="Name"></span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="info-item @(Html.ViewData.ModelState["Email"]?.Errors.Count > 0 ? "error" : "")">
                                <i class="ri-mail-line"></i>
                                <div style="flex: 1;">
                                    <input asp-for="Email" type="email" placeholder="Enter Email Address *" class="form-control" />
                                    @if (Html.ViewData.ModelState["Email"]?.Errors.Count > 0)
                                    {
                                        <div class="validation-error">
                                            <i class="ri-error-warning-line"></i>
                                            <span asp-validation-for="Email"></span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="info-item @(Html.ViewData.ModelState["PhoneNumber"]?.Errors.Count > 0 ? "error" : "")">
                                <i class="ri-phone-line"></i>
                                <div style="flex: 1;">
                                    <input asp-for="PhoneNumber" placeholder="Enter Phone Number *" class="form-control" />
                                    @if (Html.ViewData.ModelState["PhoneNumber"]?.Errors.Count > 0)
                                    {
                                        <div class="validation-error">
                                            <i class="ri-error-warning-line"></i>
                                            <span asp-validation-for="PhoneNumber"></span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="info-item @(Html.ViewData.ModelState["Password"]?.Errors.Count > 0 ? "error" : "")">
                                <i class="ri-lock-line"></i>
                                <div style="flex: 1;">
                                    <input asp-for="Password" type="password" placeholder="Enter Password *" class="form-control" />
                                    @if (Html.ViewData.ModelState["Password"]?.Errors.Count > 0)
                                    {
                                        <div class="validation-error">
                                            <i class="ri-error-warning-line"></i>
                                            <span asp-validation-for="Password"></span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="info-item @(Html.ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? "error" : "")">
                                <i class="ri-lock-password-line"></i>
                                <div style="flex: 1;">
                                    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password *" class="form-control" />
                                    @if (Html.ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0)
                                    {
                                        <div class="validation-error">
                                            <i class="ri-error-warning-line"></i>
                                            <span asp-validation-for="ConfirmPassword"></span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card-actions">
                            <button type="submit" class="action-btn view-btn" id="submitBtn">
                                <i class="ri-check-line"></i> Create Customer
                            </button>
                            <a asp-action="Index" class="action-btn delete-btn">
                                <i class="ri-close-line"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
    @section Scripts {
        <script src="~/js/Manage/common.js"></script>
        <script src="~/js/Manage/create.js"></script>
    }

</body>