@using Motorak.BLL.ModelVM.Customer
@model EditCustomerModel
@{
    ViewData["Title"] = "Edit Customer";
    Layout = "_MotorakIndex";
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.4.0/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Manage.css">
</head>

<body>
    <section class="customers-section">
        <div class="container">
            <!-- Header -->
            <div class="section-header">
                <div class="header-content">
                    <h1 class="section-title">
                        <i class="ri-edit-line"></i>
                        Edit Customer
                    </h1>
                    <p class="section-subtitle">Update customer information</p>
                </div>
                <div class="header-actions">
                    <a asp-action="Index" class="btn-secondary">
                        <i class="ri-arrow-left-line"></i>
                        Back to List
                    </a>
                    <a asp-action="CustomerDetails" asp-route-id="@Model.Id" class="btn-secondary">
                        <i class="ri-eye-line"></i>
                        View Details
                    </a>
                </div>
            </div>

            <!-- Edit Customer Form -->
            <div class="form-section">
                <div class="card-header">
                    <div class="customer-avatar">
                        <i class="ri-edit-line"></i>
                    </div>
                    <div class="customer-info">
                        <h3 class="customer-name">Editing Customer #@Model.Id</h3>
                        <p class="customer-email">Update the information below</p>
                    </div>
                </div>

                <div class="card-content">
                    <form asp-controller="Customer" asp-action="Edit" method="post" id="editCustomerForm">
                        @Html.AntiForgeryToken()
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="IsUpdated" type="hidden" />
                        <input asp-for="UpdatedAt" type="hidden" />

                        <!-- Display ModelState errors -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="validation-summary" style="background: rgba(244, 67, 54, 0.1); border: 1px solid var(--error-color); border-radius: var(--border-radius); padding: 1rem; margin-bottom: 1.5rem;">
                                <h4 style="color: var(--error-color); margin-bottom: 0.5rem;">
                                    <i class="ri-error-warning-line"></i> Please correct the following errors:
                                </h4>
                                <ul style="margin: 0; padding-left: 1rem;">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li style="color: var(--error-color); margin-bottom: 0.25rem;">@error.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="info-grid">
                            <!-- Customer ID (Read-only) -->
                            <div class="info-item">
                                <i class="ri-hashtag"></i>
                                <div style="flex: 1;">
                                    <input value="Customer ID: @Model.Id" class="form-control readonly-field" readonly />
                                </div>
                            </div>

                            <!-- Name Field -->
                            <div class="info-item @(Html.ViewData.ModelState["Name"]?.Errors.Count > 0 ? "error" : "")">
                                <i class="ri-user-line"></i>
                                <div style="flex: 1;">
                                    <input asp-for="Name" placeholder="Enter Full Name *" class="form-control" />
                                    @if (Html.ViewData.ModelState["Name"]?.Errors.Count > 0)
                                    {
                                        <div class="validation-error">
                                            <i class="ri-error-warning-line"></i>
                                            <span asp-validation-for="Name"></span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Phone Number Field -->
                            <div class="info-item @(Html.ViewData.ModelState["PhoneNumber"]?.Errors.Count > 0 ? "error" : "")">
                                <i class="ri-phone-line"></i>
                                <div style="flex: 1;">
                                    <input asp-for="PhoneNumber" placeholder="Enter Phone Number" class="form-control" />
                                    @if (Html.ViewData.ModelState["PhoneNumber"]?.Errors.Count > 0)
                                    {
                                        <div class="validation-error">
                                            <i class="ri-error-warning-line"></i>
                                            <span asp-validation-for="PhoneNumber"></span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Image Path Field (Optional) -->
                            <div class="info-item @(Html.ViewData.ModelState["ImagePath"]?.Errors.Count > 0 ? "error" : "")">
                                <i class="ri-image-line"></i>
                                <div style="flex: 1;">
                                    <input asp-for="ImagePath" placeholder="Profile Image Path (Optional)" class="form-control" />
                                    @if (Html.ViewData.ModelState["ImagePath"]?.Errors.Count > 0)
                                    {
                                        <div class="validation-error">
                                            <i class="ri-error-warning-line"></i>
                                            <span asp-validation-for="ImagePath"></span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Last Update Info -->
                            <div class="info-item">
                                <i class="ri-time-line"></i>
                                <div style="flex: 1;">
                                    <input value="Last Update: @DateTime.Now.ToString("MMM dd, yyyy 'at' hh:mm tt")" class="form-control readonly-field" readonly />
                                </div>
                            </div>
                        </div>

                        <!-- Additional Information Section -->
                        <div style="background: var(--bg-secondary); padding: 1rem; border-radius: var(--border-radius); margin: 1.5rem 0;">
                            <h4 style="color: var(--text-primary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
                                <i class="ri-information-line"></i>
                                Important Notes:
                            </h4>
                            <ul style="color: var(--text-secondary); margin: 0; padding-left: 1rem;">
                                <li>Email address cannot be changed after account creation</li>
                                <li>Phone number is optional but recommended for contact purposes</li>
                                <li>Profile image path should be a valid URL or file path</li>
                                <li>Changes will be saved immediately upon submission</li>
                            </ul>
                        </div>

                        <div class="card-actions">
                            <button type="submit" class="action-btn view-btn" id="submitBtn">
                                <i class="ri-save-line"></i> Save Changes
                            </button>
                            <a asp-action="CustomerDetails" asp-route-id="@Model.Id" class="action-btn edit-btn">
                                <i class="ri-eye-line"></i> View Details
                            </a>
                            <a asp-action="Index" class="action-btn delete-btn">
                                <i class="ri-close-line"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    @section Scripts {
        <script src="~/js/Manage/common.js"></script>
        <script src="~/js/Manage/edit.js"></script>
    }

</body>