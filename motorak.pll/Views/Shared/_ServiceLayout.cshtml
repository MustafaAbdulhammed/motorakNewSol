<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Motorak.PLL - Dashboard</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --bg-dark: #1e1b2b;
            --bg-card: #2c2640;
            --accent-purple: #b39ddb;
            --nav-purple: #3f2a56;
            --text-main: #d1c4e9;
            --transition: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background: var(--bg-dark);
            color: var(--text-main);
            display: flex;
            flex-direction: column;
        }

        /* Fixed Top Navbar */
        nav.navbar {
            background: var(--nav-purple);
            padding: 0.7rem 2rem;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1200;
            display: flex;
            align-items: center;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--accent-purple) !important;
            display: flex;
            align-items: center;
            gap: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        #sidebarToggleBtn {
            background: var(--accent-purple);
            border: none;
            color: var(--nav-purple);
            width: 40px;
            height: 40px;
            border-radius: 10px;
            margin-right: 1.5rem;
            transition: var(--transition);
        }

            #sidebarToggleBtn:hover {
                transform: rotate(90deg);
                background: #fff;
            }

        /* Sidebar Glassmorphism */
        #sidebarMenu {
            position: fixed;
            top: 60px;
            left: 0;
            width: 260px;
            height: calc(100vh - 60px);
            background: linear-gradient(180deg, #3f2a56 0%, #2c2640 100%);
            padding: 1.5rem 1rem;
            transition: var(--transition);
            z-index: 1100;
            border-right: 1px solid rgba(179, 157, 219, 0.1);
        }

            #sidebarMenu.hidden {
                transform: translateX(-100%);
            }

            #sidebarMenu a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 15px;
                color: var(--text-main);
                text-decoration: none;
                border-radius: 12px;
                margin-bottom: 5px;
                transition: 0.3s;
                font-weight: 500;
            }

                #sidebarMenu a i {
                    width: 25px;
                    font-size: 1.2rem;
                    color: var(--accent-purple);
                }

                #sidebarMenu a:hover {
                    background: rgba(179, 157, 219, 0.15);
                    color: #fff;
                    padding-left: 20px;
                }

                #sidebarMenu a.active {
                    background: var(--accent-purple);
                    color: var(--nav-purple) !important;
                }

                    #sidebarMenu a.active i {
                        color: var(--nav-purple);
                    }

        /* Content Area */
        .main-container {
            flex: 1;
            margin-left: 260px;
            margin-top: 60px;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
        }

            .main-container.fullwidth {
                margin-left: 0;
            }

        .content-wrapper {
            padding: 2rem;
            flex: 1;
        }

        /* Improved Hero Section */
        .hero {
            background: linear-gradient(135deg, #4b367c 0%, #6a5aa0 100%);
            padding: 4rem 2rem;
            border-radius: 20px;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

            .hero h1 {
                font-size: 3rem;
                font-weight: 800;
                color: #fff;
            }

            .hero p {
                color: #e6deff;
                font-size: 1.1rem;
                opacity: 0.9;
            }

        /* Footer Sticky Bottom */
        footer.footer {
            background: var(--nav-purple);
            padding: 1.5rem;
            text-align: center;
            border-top: 1px solid rgba(179, 157, 219, 0.1);
            color: var(--accent-purple);
        }

        /* Mobile Adjustments */
        @@media (max-width: 768px) {
            #sidebarMenu

        {
            transform: translateX(-100%);
        }

        #sidebarMenu.active {
            transform: translateX(0);
        }

        .main-container {
            margin-left: 0;
        }

        }
    </style>
</head>
<body>

    <nav class="navbar">
        <button id="sidebarToggleBtn">
            <i class="fas fa-bars"></i>
        </button>
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <i class="fas fa-car-side"></i> Motorak.PLL
        </a>
    </nav>

    <aside id="sidebarMenu">
        <div class="sidebar-section mb-3 text-uppercase small opacity-50 px-3">Main Menu</div>
        <a asp-controller="Dashboard" asp-action="Index" class="active">
            <i class="fas fa-chart-pie"></i> Dashboard
        </a>

        <div class="sidebar-section mb-3 mt-4 text-uppercase small opacity-50 px-3">Services</div>
        <a asp-controller="Services" asp-action="Index">
            <i class="fas fa-list"></i> All Services
        </a>
        <a asp-controller="Service" asp-action="Create">
            <i class="fas fa-plus-circle"></i> New Service
        </a>

        <div class="sidebar-section mb-3 mt-4 text-uppercase small opacity-50 px-3">System</div>
        <a asp-controller="Home" asp-action="Privacy">
            <i class="fas fa-shield-alt"></i> Security
        </a>
    </aside>

    <div class="main-container" id="mainContainer">
        <div class="content-wrapper">
            <section class="hero">
                <div class="container text-center">
                    <h1>Welcome to Motorak</h1>
                    <p>Streamlined vehicle management for professionals.</p>
                    <a href="#" class="btn btn-light btn-lg rounded-pill px-5 fw-bold">
                        Start Now <i class="fas fa-chevron-right ms-2"></i>
                    </a>
                </div>
            </section>

            <main role="main" class="container-fluid">
                @RenderBody()
            </main>
        </div>

        <footer class="footer">
            <div class="container">
                &copy; @DateTime.Now.Year - <strong>Motorak.PLL</strong> |
                <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none ms-2">Privacy Policy</a>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const btn = document.getElementById('sidebarToggleBtn');
        const menu = document.getElementById('sidebarMenu');
        const container = document.getElementById('mainContainer');

        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
            container.classList.toggle('fullwidth');
        });

        // Close sidebar on mobile when clicking content
        window.addEventListener('resize', () => {
            if (window.innerWidth < 768) {
                menu.classList.add('hidden');
                container.classList.add('fullwidth');
            }
        });
    </script>
</body>
</html>