@using Microsoft.AspNetCore.Identity
@using motorak.dal.Entites
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<header class="header" id="header">
    <nav class="nav container">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="nav__logo">
            <i class="ri-steering-fill"></i>
            Motorak
        </a>

        <div class="nav__menu" id="nav-menu">
            <ul class="nav__list">
                <li class="nav__item">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="nav__link">Home</a>
                </li>
                <li class="nav__item">
                    <a asp-controller="Service" asp-action="Index" class="nav__link">
                        <i class="ri-service-fill"></i> Services
                    </a>
                </li>
                <li class="nav__item">
                    <a asp-controller="Mechanic" asp-action="Index" class="nav__link">
                        <i class="ri-tools-fill"></i> Mechanics
                    </a>
                </li>
                <li class="nav__item">
                    <a asp-controller="Car" asp-action="Index" class="nav__link">
                        <i class="ri-car-fill"></i> Cars
                    </a>
                </li>

                @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                {
                    <li class="nav__item">
                        <a asp-controller="Purchase" asp-action="Index" class="nav__link">
                            <i class="ri-shopping-bag-line"></i> Purchases
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Rent" asp-action="Index" class="nav__link">
                            <i class="ri-calendar-line"></i> Rentals
                        </a>
                    </li>
                }
            </ul>

            <div class="nav__language">
                @{
                    var currentUrl = Context.Request.Path + Context.Request.QueryString;
                }
                <a class="lang-link" asp-controller="Home" asp-action="SetLanguage" asp-route-culture="en-US" asp-route-returnUrl="@currentUrl">
                    <img src="~/assets/img/US_Flag.png" width="20" height="12" alt="English" />
                    <span>EN</span>
                </a>
                <a class="lang-link" asp-controller="Home" asp-action="SetLanguage" asp-route-culture="ar-EG" asp-route-returnUrl="@currentUrl">
                    <img src="~/assets/img/EG_Flag.png" width="20" height="12" alt="Arabic" />
                    <span>AR</span>
                </a>
            </div>

            <div class="nav__auth">
                @if (SignInManager.IsSignedIn(User))
                {
                    var user = await UserManager.GetUserAsync(User);
                    var userName = user?.UserName ?? "User";
                    // Improvement: Better logic for initials (Handle single-character names safely)
                    var initials = userName.Length >= 2 ? userName.Substring(0, 2).ToUpper() : userName.ToUpper();

                    <div class="nav__user-container">
                        <a id="manage" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage Account" class="nav__user">
                            <div class="nav__user-avatar">@initials</div>
                            <span class="nav__username">@userName</span>
                        </a>

                        <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                            <button id="logout" type="submit" class="nav__logout-btn">
                                <i class="ri-logout-circle-line"></i>
                                Logout
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="nav__auth-links">
                        <a id="register" asp-area="Identity" asp-page="/Account/Register" class="nav__register">
                            <i class="ri-user-add-line"></i> Register
                        </a>
                        <a id="login" asp-area="Identity" asp-page="/Account/Login" class="nav__login">
                            <i class="ri-login-circle-line"></i> Sign In
                        </a>
                    </div>
                }
            </div>

            <div class="nav__close" id="nav-close">
                <i class="ri-close-line"></i>
            </div>
        </div>

        <div class="nav__toggle" id="nav-toggle">
            <i class="ri-menu-line"></i>
        </div>

    </nav>
</header>

<style>
    /* Improvements: Enhanced layout for the auth and language sections */
    .nav__language {
        display: flex;
        gap: 0.5rem;
        margin: 0 1rem;
        align-items: center;
    }

    .lang-link {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.4rem 0.6rem;
        border-radius: 6px;
        background: rgba(251,191,36,0.1);
        color: #fbbf24;
        font-size: 0.85rem;
        font-weight: 600;
        transition: 0.3s;
    }

        .lang-link:hover {
            background: #fbbf24;
            color: #1c1008;
        }

    .nav__auth {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .nav__user-container {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .nav__user {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #fbbf24;
        font-weight: 500;
    }

    .nav__user-avatar {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: linear-gradient(135deg, #fbbf24, #d97706);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1c1008;
        font-size: 0.8rem;
        box-shadow: 0 2px 8px rgba(217, 119, 6, 0.3);
    }

    .nav__logout-btn {
        background: rgba(255, 107, 107, 0.1);
        border: 1px solid rgba(255, 107, 107, 0.2);
        color: #ff6b6b;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-size: 0.9rem;
        transition: 0.3s;
    }

        .nav__logout-btn:hover {
            background: #ff6b6b;
            color: #fff;
        }

    .nav__auth-links {
        display: flex;
        gap: 1rem;
    }

    .nav__login, .nav__register {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        color: #fbbf24;
        font-size: 0.95rem;
    }

        .nav__login:hover, .nav__register:hover {
            color: #fff;
        }

    /* Media query for mobile responsiveness */
    @@media screen and (max-width: 767px) {
        .nav__auth, .nav__language {
            flex-direction: column;
            align-items: flex-start;
            margin: 1rem 0;
        }

        .nav__user-container {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
