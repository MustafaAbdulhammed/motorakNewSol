@using Motorak.BLL.ModelVM.Service
@using Motorak.DAL.Enums.SeviceEnums
@using Motorak.Utility
@model List<ServiceDTO>

@{
    ViewData["Title"] = "Services List";
    var userRole = User.IsInRole(Seed.Role_Admin) ? Seed.Role_Admin :
                   User.IsInRole(Seed.Role_Mechanic) ? Seed.Role_Mechanic : Seed.Role_Customer;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
    * {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
        background: linear-gradient(135deg, #0a0a0f 0%, #1a0d2e 25%, #2d1b69 50%, #1a0d2e 75%, #0a0a0f 100%);
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
    }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 30%, rgba(139, 92, 246, 0.15) 0%, transparent 50%), radial-gradient(circle at 80% 70%, rgba(168, 85, 247, 0.12) 0%, transparent 50%), radial-gradient(circle at 40% 80%, rgba(124, 58, 237, 0.18) 0%, transparent 50%);
            pointer-events: none;
            z-index: -1;
        }

    .container {
        position: relative;
        z-index: 1;
        max-width: 1400px;
    }

    .page-header {
        text-align: center;
        padding: 2.5rem 0;
        margin-bottom: 2rem;
    }

    .page-title {
        font-weight: 900;
        font-size: 3.5rem;
        background: linear-gradient(135deg, #ffffff 0%, #e0e7ff 30%, #c7d2fe 60%, #a78bfa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 1rem;
        letter-spacing: -2px;
        text-shadow: 0 0 60px rgba(139, 92, 246, 0.3);
    }

    .page-subtitle {
        color: rgba(255, 255, 255, 0.7);
        font-size: 1.2rem;
        font-weight: 300;
        letter-spacing: 0.5px;
    }

    .stats-bar {
        background: rgba(15, 15, 35, 0.8);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 24px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    .stats-item {
        text-align: center;
        color: white;
    }

    .stats-number {
        font-size: 2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        display: block;
    }

    .stats-label {
        font-size: 0.875rem;
        color: rgba(255, 255, 255, 0.6);
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 500;
    }

    .add-service-btn, .create-service-btn {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        border: none;
        border-radius: 20px;
        padding: 14px 28px;
        font-weight: 700;
        color: white;
        transition: all 0.4s ease;
        box-shadow: 0 12px 24px rgba(139, 92, 246, 0.4);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-size: 0.9rem;
    }

        .add-service-btn:hover, .create-service-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 32px rgba(139, 92, 246, 0.6);
            color: white;
        }

    .services-grid {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    }

    .service-card {
        background: rgba(15, 15, 35, 0.9);
        backdrop-filter: blur(30px);
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-radius: 24px;
        padding: 2rem;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

        .service-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #8b5cf6, #7c3aed, #a855f7, #c084fc);
        }

        .service-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 30px 60px rgba(139, 92, 246, 0.4), 0 0 80px rgba(139, 92, 246, 0.2);
            border-color: rgba(139, 92, 246, 0.6);
        }

    .service-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .service-id {
        font-weight: 900;
        font-size: 1.8rem;
        background: linear-gradient(135deg, #8b5cf6 0%, #c084fc 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-shadow: 0 0 20px rgba(139, 92, 246, 0.5);
    }

    .service-status {
        padding: 8px 16px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .status-pending {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
    }

    .status-completed {
        background: linear-gradient(135deg, #10b981 0%, #047857 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
    }

    .status-cancelled {
        background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4);
    }

    .status-unknown {
        background: linear-gradient(135deg, #6b7280 0%, #374151 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(107, 114, 128, 0.4);
    }

    .service-info {
        margin-bottom: 2rem;
    }

    .info-item {
        display: flex;
        align-items: center;
        margin-bottom: 1rem;
        color: rgba(255, 255, 255, 0.9);
    }

    .info-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1rem;
        font-size: 1.2rem;
        background: rgba(139, 92, 246, 0.2);
        color: #a78bfa;
        border: 1px solid rgba(139, 92, 246, 0.3);
    }

    .info-content {
        flex: 1;
    }

    .info-label {
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.6);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.25rem;
    }

    .info-value {
        font-size: 1rem;
        font-weight: 600;
        color: white;
    }

    .service-type-value {
        background: rgba(199, 210, 254, 0.2);
        padding: 4px 12px;
        border-radius: 20px;
        border: 1px solid rgba(199, 210, 254, 0.3);
        color: #c7d2fe;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-size: 0.9rem;
    }

    .service-actions {
        display: flex;
        gap: 8px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .action-btn {
        padding: 10px 16px;
        border: none;
        border-radius: 16px;
        font-weight: 600;
        font-size: 0.85rem;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        flex: 1;
        justify-content: center;
        min-width: 70px;
    }

    .btn-view {
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
    }

        .btn-view:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.5);
            color: white;
        }

    .btn-edit {
        background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
    }

        .btn-edit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(139, 92, 246, 0.5);
            color: white;
        }

    .btn-delete {
        background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
    }

        .btn-delete:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(239, 68, 68, 0.5);
            color: white;
        }

    .btn-accept {
        background: linear-gradient(135deg, #10b981 0%, #047857 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }

        .btn-accept:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.5);
            color: white;
        }

    .btn-reject {
        background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
    }

        .btn-reject:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(239, 68, 68, 0.5);
            color: white;
        }

    .btn-review {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
    }

        .btn-review:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(245, 158, 11, 0.5);
            color: white;
        }

    .no-data-container {
        text-align: center;
        padding: 4rem 2rem;
        color: rgba(255, 255, 255, 0.6);
        background: rgba(15, 15, 35, 0.8);
        border-radius: 24px;
        border: 1px solid rgba(139, 92, 246, 0.2);
    }

    .no-data-icon {
        font-size: 4rem;
        color: rgba(139, 92, 246, 0.3);
        margin-bottom: 1rem;
    }

    .no-data-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: rgba(255, 255, 255, 0.8);
    }

    .alert-custom {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, rgba(185, 28, 28, 0.15) 100%);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        color: #fca5a5;
        font-weight: 600;
        margin-bottom: 2rem;
        box-shadow: 0 10px 25px rgba(239, 68, 68, 0.2);
        backdrop-filter: blur(10px);
    }

    .customer-actions {
        text-align: center;
        padding: 2rem;
    }

    .alert {
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        font-weight: 600;
        border: none;
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    .alert-success {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(4, 120, 87, 0.15) 100%);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #6ee7b7;
    }

    .alert-danger {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, rgba(185, 28, 28, 0.15) 100%);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #fca5a5;
    }
</style>

<div class="container mt-4">
    <div class="page-header">
        <h1 class="page-title">Services Dashboard</h1>
        <p class="page-subtitle">Advanced management system for all your services</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row stats-bar">
            <div class="col-md-3 stats-item">
                <span class="stats-number">@Model.Count</span>
                <span class="stats-label">Total Services</span>
            </div>
            <div class="col-md-3 stats-item">
                <span class="stats-number">@Model.Count(x => x.Status == Status.Pending)</span>
                <span class="stats-label">Pending</span>
            </div>
            <div class="col-md-3 stats-item">
                <span class="stats-number">@Model.Count(x => x.Status == Status.Completed)</span>
                <span class="stats-label">Completed</span>
            </div>
            <div class="col-md-3 stats-item">
                <span class="stats-number">@Model.Count(x => x.Status == Status.Cancelled)</span>
                <span class="stats-label">Cancelled</span>
            </div>
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert-custom">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @ViewBag.ErrorMessage
        </div>
    }
    else
    {
        @if (userRole == Seed.Role_Admin)
        {
            <div class="d-flex justify-content-end mb-4">
                <a href="@Url.Action("Create")" class="add-service-btn">
                    <i class="bi bi-plus-circle"></i>
                    Add New Service
                </a>
            </div>
        }

        @if (userRole == Seed.Role_Customer)
        {
            <div class="customer-actions">
                <a href="@Url.Action("Create")" class="create-service-btn">
                    <i class="bi bi-plus-circle"></i>
                    Create New Service Request
                </a>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="services-grid">
                @foreach (var item in Model)
                {
                    <div class="service-card">
                        <div class="service-header">
                            <div class="service-id">#@item.ServiceId</div>
                            <div class="service-status @(item.Status == Status.Pending ? "status-pending" :
                                  item.Status == Status.Completed ? "status-completed" :
                                 item.Status == Status.Cancelled ? "status-cancelled" :
                                   "status-unknown")">
                    @switch (item.Status)
                                {
                                    case Status.Pending:
                                        <i class="bi bi-hourglass-split"></i>
                                        <span>Pending</span>
                                        break;
                                    case Status.Completed:
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span>Completed</span>
                                        break;
                                    case Status.Cancelled:
                                        <i class="bi bi-x-circle-fill"></i>
                                        <span>Cancelled</span>
                                        break;
                                    default:
                                        <i class="bi bi-question-circle"></i>
                                        <span>Unknown</span>
                                        break;
                                }
                            </div>
                        </div>

                        <div class="service-info">
                            <div class="info-item">
                                <div class="info-icon">
                                    <i class="bi bi-person-gear"></i>
                                </div>
                                <div class="info-content">
                                    <div class="info-label">Mechanic ID</div>
                                    <div class="info-value">@item.MechanicId</div>
                                </div>
                            </div>

                            <div class="info-item">
                                <div class="info-icon">
                                    <i class="bi bi-tools"></i>
                                </div>
                                <div class="info-content">
                                    <div class="info-label">Service Type</div>
                                    <div class="service-type-value">@item.ServiceType</div>
                                </div>
                            </div>

                            <div class="info-item">
                                <div class="info-icon">
                                    <i class="bi bi-calendar"></i>
                                </div>
                                <div class="info-content">
                                    <div class="info-label">Created Date</div>
                                    <div class="info-value">@item.CreatedDate.ToString("MMM dd, yyyy")</div>
                                </div>
                            </div>
                        </div>

                        <div class="service-actions">
                            @if (userRole == Seed.Role_Admin)
                            {
                                <a class="action-btn btn-view" href="@Url.Action("Details", new { id = item.ServiceId })">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <a class="action-btn btn-edit" href="@Url.Action("Edit", new { id = item.ServiceId })">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a class="action-btn btn-delete" href="@Url.Action("Delete", new { id = item.ServiceId })">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            }
                            else if (userRole == Seed.Role_Mechanic)
                            {
                                @if (item.Status == Status.Pending)
                                {
                                    <a class="action-btn btn-accept" href="@Url.Action("Accept", new { id = item.ServiceId })">
                                        <i class="bi bi-check-circle"></i> Accept
                                    </a>
                                    <a class="action-btn btn-reject" href="@Url.Action("Reject", new { id = item.ServiceId })">
                                        <i class="bi bi-x-circle"></i> Reject
                                    </a>
                                }
                                else
                                {
                                    <div class="text-center text-muted" style="color: rgba(255,255,255,0.5) !important;">
                                        <small>Service already processed</small>
                                    </div>
                                }
                            }
                            else if (userRole == Seed.Role_Customer)
                            {
                                @if (item.Status == Status.Completed)
                                {
                                    <a class="action-btn btn-review" href="@Url.Action("Create", "ServiceReview", new { serviceId = item.ServiceId })">
                                        <i class="bi bi-star-fill"></i> Rate Service
                                    </a>
                                }
                                else if (item.Status == Status.Pending)
                                {
                                    <div class="text-center text-muted" style="color: rgba(255,255,255,0.5) !important;">
                                        <small><i class="bi bi-clock me-1"></i>Service in progress...</small>
                                    </div>
                                }
                                else if (item.Status == Status.Cancelled)
                                {
                                    <div class="text-center text-muted" style="color: rgba(255,255,255,0.5) !important;">
                                        <small><i class="bi bi-x-circle me-1"></i>Service cancelled</small>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center text-muted" style="color: rgba(255,255,255,0.5) !important;">
                                        <small><i class="bi bi-info-circle me-1"></i>Status: @item.Status.ToString().ToUpper()</small>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="no-data-container">
                <div class="no-data-icon">
                    <i class="bi bi-inbox"></i>
                </div>
                <div class="no-data-title">No services available</div>
                @if (userRole == Seed.Role_Admin)
                {
                    <p>Start by adding your first service to get started</p>
                }
                else if (userRole == Seed.Role_Customer)
                {
                    <p>Create your first service request to get started</p>
                }
                else
                {
                    <p>No pending services to process at the moment</p>
                }
            </div>
        }
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const cards = document.querySelectorAll('.service-card');
        cards.forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(30px)';
            setTimeout(() => {
                card.style.transition = 'all 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, index * 100);
        });

        document.querySelectorAll('.btn-delete, .btn-reject').forEach(btn => {
            btn.addEventListener('click', function(e) {
                const action = this.classList.contains('btn-delete') ? 'delete' : 'reject';
                if (!confirm(`Are you sure you want to ${action} this service?`)) {
                    e.preventDefault();
                }
            });
        });

        document.querySelectorAll('.btn-accept').forEach(btn => {
            btn.addEventListener('click', function(e) {
                if (!confirm('Are you sure you want to accept this service request?')) {
                    e.preventDefault();
                }
            });
        });

        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(function(alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    });
</script>