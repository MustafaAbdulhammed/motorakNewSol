@using Motorak.BLL.ModelVM.Service
@using Motorak.DAL.Enums.SeviceEnums
@model ServiceDTO
@{
    ViewData["Title"] = "Delete Service";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #0d0d1f 0%, #0f1629 25%, #0a1f3a 50%, #2d1b4e 75%, #4a2c70 100%);
        min-height: 100vh;
        font-family: 'Inter', sans-serif;
        color: #ffffff;
        overflow-x: hidden;
        position: relative;
    }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 80%, rgba(80, 79, 140, 0.2) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(180, 79, 140, 0.2) 0%, transparent 50%), radial-gradient(circle at 40% 40%, rgba(80, 79, 140, 0.15) 0%, transparent 50%);
            z-index: -1;
        }

        body::after {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: radial-gradient(2px 2px at 20px 30px, rgba(255, 255, 255, 0.1), transparent), radial-gradient(2px 2px at 40px 70px, rgba(139, 95, 191, 0.2), transparent), radial-gradient(1px 1px at 90px 40px, rgba(255, 255, 255, 0.15), transparent), radial-gradient(1px 1px at 130px 80px, rgba(139, 95, 191, 0.1), transparent);
            background-size: 200px 100px;
            z-index: -1;
            opacity: 0.3;
        }

    .main-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .delete-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(25px) saturate(180%);
        border: 2px solid;
        border-image: linear-gradient(45deg, rgba(139, 95, 191, 0.6), rgba(100, 70, 150, 0.4), rgba(75, 60, 180, 0.6)) 1;
        border-radius: 24px;
        padding: 3rem;
        max-width: 600px;
        width: 100%;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.7), 0 0 40px rgba(100, 70, 150, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.1), inset 0 -1px 0 rgba(0, 0, 0, 0.2);
        position: relative;
        overflow: hidden;
        transform: perspective(1000px) rotateX(0deg);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

        .delete-card:hover {
            transform: perspective(1000px) rotateX(2deg) translateY(-10px);
            box-shadow: 0 40px 80px rgba(0, 0, 0, 0.8), 0 0 60px rgba(100, 70, 150, 0.4), inset 0 2px 0 rgba(255, 255, 255, 0.2), inset 0 -2px 0 rgba(0, 0, 0, 0.3);
        }

        .delete-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(from 0deg, transparent, rgba(139, 95, 191, 0.1), transparent, rgba(100, 70, 150, 0.05), transparent);
            z-index: -1;
            opacity: 0.6;
        }

        .delete-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, transparent 20%, transparent 80%, rgba(139, 95, 191, 0.05) 100%);
            border-radius: 24px;
            pointer-events: none;
            z-index: 1;
        }

    .page-title {
        text-align: center;
        margin-bottom: 2rem;
        font-weight: 700;
        font-size: 2.5rem;
        background: linear-gradient(135deg, #d946b8, #9333ea, #6b46c1, #4338ca);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-shadow: 0 0 30px rgba(100, 70, 150, 0.5);
        position: relative;
        filter: drop-shadow(0 4px 8px rgba(147, 51, 234, 0.3));
        transition: all 0.3s ease;
    }

        .page-title:hover {
            transform: scale(1.05);
            filter: drop-shadow(0 8px 16px rgba(147, 51, 234, 0.5));
        }

        .page-title::before {
            content: '';
            position: absolute;
            top: -10px;
            left: -10px;
            right: -10px;
            bottom: -10px;
            background: radial-gradient(ellipse at center, rgba(147, 51, 234, 0.1) 0%, transparent 70%);
            border-radius: 50%;
            z-index: -1;
            transition: all 0.3s ease;
        }

        .page-title:hover::before {
            transform: scale(1.2);
            background: radial-gradient(ellipse at center, rgba(147, 51, 234, 0.2) 0%, transparent 70%);
        }

    .warning-alert {
        background: linear-gradient(135deg, rgba(180, 70, 120, 0.15), rgba(100, 70, 150, 0.15));
        border: 2px solid rgba(180, 70, 120, 0.4);
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        text-align: center;
        font-weight: 500;
        font-size: 1.1rem;
        box-shadow: 0 10px 30px rgba(180, 70, 120, 0.15);
        position: relative;
        overflow: hidden;
        transform: translateZ(0);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .warning-alert::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transition: left 2s ease;
        }

        .warning-alert:hover::before {
            left: 100%;
        }

        .warning-alert:hover {
            transform: translateY(-2px) scale(1.02);
            border-color: rgba(180, 70, 120, 0.6);
            box-shadow: 0 15px 40px rgba(180, 70, 120, 0.25);
        }

        .warning-alert i {
            font-size: 1.5rem;
            margin-right: 0.5rem;
            color: #d946b8;
            filter: drop-shadow(0 0 8px rgba(217, 70, 184, 0.4));
            transition: all 0.3s ease;
        }

        .warning-alert:hover i {
            transform: scale(1.1);
            filter: drop-shadow(0 0 12px rgba(217, 70, 184, 0.6));
        }

    .service-info-card {
        background: linear-gradient(135deg, rgba(100, 70, 150, 0.12), rgba(75, 60, 180, 0.12));
        border: 1px solid rgba(100, 70, 150, 0.3);
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        overflow: hidden;
    }

        .service-info-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(139, 95, 191, 0.5), transparent);
            transition: all 0.3s ease;
        }

        .service-info-card::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: radial-gradient(circle, rgba(139, 95, 191, 0.1) 0%, transparent 70%);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: all 0.6s ease;
            z-index: -1;
        }

        .service-info-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5), 0 0 50px rgba(100, 70, 150, 0.3);
            border-color: rgba(139, 95, 191, 0.5);
        }

            .service-info-card:hover::before {
                height: 2px;
                background: linear-gradient(90deg, transparent, rgba(139, 95, 191, 0.8), rgba(255, 255, 255, 0.3), rgba(139, 95, 191, 0.8), transparent);
            }

            .service-info-card:hover::after {
                width: 300px;
                height: 300px;
            }

    .service-id {
        font-size: 2rem;
        font-weight: 700;
        color: #9333ea;
        margin-bottom: 1rem;
        text-shadow: 0 0 20px rgba(100, 70, 150, 0.5);
        position: relative;
        z-index: 2;
        transition: all 0.3s ease;
    }

        .service-id:hover {
            color: #a855f7;
            text-shadow: 0 0 30px rgba(168, 85, 247, 0.7);
            transform: translateX(5px);
        }

    .info-row {
        display: flex;
        align-items: center;
        margin-bottom: 1rem;
        font-size: 1.1rem;
    }

    .info-label {
        font-weight: 600;
        margin-right: 1rem;
        color: #c1c1c1;
        min-width: 120px;
    }

    .status-badge {
        padding: 0.5rem 1rem;
        border-radius: 25px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    }

    .status-pending {
        background: linear-gradient(135deg, #f39c12, #f1c40f);
        color: #2c3e50;
    }

    .status-completed {
        background: linear-gradient(135deg, #27ae60, #2ecc71);
        color: white;
    }

    .status-cancelled {
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        color: white;
    }

    .status-unknown {
        background: linear-gradient(135deg, #95a5a6, #7f8c8d);
        color: white;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
    }

    .btn-delete {
        background: linear-gradient(135deg, #e74c3c, #c0392b, #8e44ad);
        border: none;
        color: white;
        padding: 1rem 2rem;
        border-radius: 15px;
        font-weight: 600;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 10px 25px rgba(231, 76, 60, 0.4);
        position: relative;
        overflow: hidden;
        transform: perspective(1000px) rotateY(0deg);
    }

        .btn-delete::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.6s ease;
            transform: skewX(-25deg);
        }

        .btn-delete::after {
            content: '';
            position: absolute;
            inset: 2px;
            background: linear-gradient(135deg, #e74c3c, #c0392b, #8e44ad);
            border-radius: 13px;
            z-index: -1;
            transition: all 0.3s ease;
        }

        .btn-delete:hover::before {
            left: 100%;
        }

        .btn-delete:hover {
            transform: perspective(1000px) rotateY(-5deg) translateY(-5px) scale(1.05);
            box-shadow: 0 20px 50px rgba(231, 76, 60, 0.6), 0 0 30px rgba(231, 76, 60, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }

        .btn-delete:active {
            transform: perspective(1000px) rotateY(-2deg) translateY(-2px) scale(1.02);
        }

    .btn-cancel {
        background: linear-gradient(135deg, rgba(100, 70, 150, 0.7), rgba(75, 60, 180, 0.7));
        border: 2px solid rgba(100, 70, 150, 0.4);
        color: white;
        padding: 1rem 2rem;
        border-radius: 15px;
        font-weight: 600;
        font-size: 1.1rem;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 10px 25px rgba(100, 70, 150, 0.3);
        position: relative;
        overflow: hidden;
        transform: perspective(1000px) rotateY(0deg);
    }

        .btn-cancel::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.6s ease;
            transform: skewX(-25deg);
        }

        .btn-cancel::after {
            content: '';
            position: absolute;
            inset: 2px;
            background: linear-gradient(135deg, rgba(100, 70, 150, 0.7), rgba(75, 60, 180, 0.7));
            border-radius: 13px;
            z-index: -1;
        }

        .btn-cancel:hover::before {
            left: 100%;
        }

        .btn-cancel:hover {
            transform: perspective(1000px) rotateY(5deg) translateY(-5px) scale(1.05);
            box-shadow: 0 20px 50px rgba(100, 70, 150, 0.5), 0 0 30px rgba(100, 70, 150, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.2);
            color: white;
            text-decoration: none;
            border-color: rgba(139, 95, 191, 0.6);
        }

        .btn-cancel:active {
            transform: perspective(1000px) rotateY(2deg) translateY(-2px) scale(1.02);
        }

    .btn i {
        margin-right: 0.5rem;
        font-size: 1.2rem;
    }
</style>

<div class="main-container">
    <div class="delete-card">
        <h1 class="page-title">
            <i class="bi bi-exclamation-diamond-fill"></i>
            Delete Service
        </h1>

        <div class="warning-alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            Are you absolutely sure you want to delete this service? This action cannot be undone!
        </div>

        <div class="service-info-card">
            <div class="service-id">Service ID: @Model.ServiceId</div>

            <div class="info-row">
                <span class="info-label">Status:</span>
                @switch (Model.Status)
                {
                    case Status.Pending:
                        <span class="status-badge status-pending">
                            <i class="bi bi-clock-fill"></i> Pending
                        </span>
                        break;
                    case Status.Completed:
                        <span class="status-badge status-completed">
                            <i class="bi bi-check-circle-fill"></i> Completed
                        </span>
                        break;
                    case Status.Cancelled:
                        <span class="status-badge status-cancelled">
                            <i class="bi bi-x-circle-fill"></i> Cancelled
                        </span>
                        break;
                    default:
                        <span class="status-badge status-unknown">
                            <i class="bi bi-question-circle-fill"></i> Unknown
                        </span>
                        break;
                }
            </div>

            <div class="info-row">
                <span class="info-label">Created:</span>
                <span><i class="bi bi-calendar-event"></i> @Model.CreatedDate.ToString("yyyy-MM-dd")</span>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="ServiceId" />
            <div class="action-buttons">
                <button type="submit" class="btn-delete">
                    <i class="bi bi-trash3-fill"></i>
                    Yes, Delete Forever
                </button>
                <a asp-action="Index" class="btn-cancel">
                    <i class="bi bi-shield-x"></i>
                    Keep Safe & Cancel
                </a>
            </div>
        </form>
    </div>
</div>