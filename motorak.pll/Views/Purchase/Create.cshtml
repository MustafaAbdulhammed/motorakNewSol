@* ============================================================
   PURCHASE CREATE VIEW
   File: motorak.pll/Views/Purchase/Create.cshtml
   ============================================================ *@
@using Motorak.BLL.ModelVM.Purchases
@model PurchaseCreateDto

@{
    ViewData["Title"] = "Create Purchase";
    Layout = "_MotorakIndex";
}

<style>
    :root {
        --gold: #fbbf24;
        --gold-border: rgba(251,191,36,0.3);
    }

    .purchase-form-page {
        min-height: 100vh;
        padding: 2rem 0 5rem;
        position: relative;
    }

        .purchase-form-page::before {
            content: '';
            position: fixed;
            inset: 0;
            background: radial-gradient(ellipse at 20% 25%, rgba(251,191,36,0.07) 0%, transparent 55%), radial-gradient(ellipse at 80% 75%, rgba(245,158,11,0.06) 0%, transparent 55%);
            pointer-events: none;
            z-index: -1;
        }

        .purchase-form-page::after {
            content: '';
            position: fixed;
            inset: 0;
            background-image: linear-gradient(rgba(251,191,36,0.022) 1px, transparent 1px), linear-gradient(90deg, rgba(251,191,36,0.022) 1px, transparent 1px);
            background-size: 55px 55px;
            pointer-events: none;
            z-index: -1;
        }

    .container {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 1.5rem;
        position: relative;
        z-index: 1;
    }

    .form-header {
        text-align: center;
        padding: 3rem 0 2.5rem;
        opacity: 0;
        animation: slideDown 0.9s cubic-bezier(0.23,1,0.32,1) forwards;
    }

    .form-icon-wrap {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 72px;
        height: 72px;
        border-radius: 22px;
        background: linear-gradient(135deg, rgba(251,191,36,0.22), rgba(251,191,36,0.05));
        border: 1px solid var(--gold-border);
        font-size: 2rem;
        margin-bottom: 1.2rem;
        box-shadow: 0 0 35px rgba(251,191,36,0.15);
        animation: goldPulse 3s ease-in-out infinite;
    }

    @@keyframes goldPulse {
        0%,100%

    {
        box-shadow: 0 0 35px rgba(251,191,36,0.15);
    }

    50% {
        box-shadow: 0 0 60px rgba(251,191,36,0.3);
    }

    }

    .form-title {
        font-family: 'Exo 2', 'Segoe UI', sans-serif;
        font-size: 2.8rem;
        font-weight: 900;
        background: linear-gradient(135deg, #fff 0%, #fef3c7 40%, #fbbf24 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: -0.5px;
    }

    .form-subtitle {
        color: rgba(254,243,199,0.5);
        font-size: 1rem;
        margin-top: 0.4rem;
    }

    .form-card {
        background: rgba(10,18,35,0.9);
        backdrop-filter: blur(28px);
        border: 1px solid rgba(251,191,36,0.18);
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 30px 60px rgba(0,0,0,0.4);
        opacity: 0;
        transform: translateY(30px) scale(0.97);
        animation: cardIn 0.8s 0.35s cubic-bezier(0.34,1.56,0.64,1) forwards;
    }

    @@keyframes cardIn {
        to

    {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    }

    .card-top-bar {
        height: 3px;
        background: linear-gradient(90deg, #d97706, #fbbf24, #f59e0b, #fbbf24, #d97706);
        background-size: 200% 100%;
        animation: shimmerGold 3s linear infinite;
    }

    @@keyframes shimmerGold {
        0%

    {
        background-position: -200% 0;
    }

    100% {
        background-position: 200% 0;
    }

    }

    .card-body-inner {
        padding: 2.5rem;
    }

    .val-summary {
        background: rgba(244,63,94,0.1);
        border: 1px solid rgba(244,63,94,0.3);
        border-radius: 16px;
        padding: 1.2rem 1.5rem;
        margin-bottom: 1.5rem;
        color: #fda4af;
        font-size: 0.9rem;
    }

        .val-summary ul {
            margin: 0;
            padding-left: 1.2rem;
        }

    .form-section {
        background: rgba(251,191,36,0.04);
        border: 1px solid rgba(251,191,36,0.1);
        border-radius: 18px;
        padding: 1.8rem;
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
    }

        .form-section:hover {
            background: rgba(251,191,36,0.07);
            border-color: rgba(251,191,36,0.18);
        }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.9rem;
        font-weight: 700;
        color: rgba(254,243,199,0.8);
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 1.4rem;
    }

        .section-title i {
            color: var(--gold);
        }

    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.2rem;
    }

    .field-group {
        margin-bottom: 1.2rem;
    }

    .field-label {
        display: block;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: rgba(254,243,199,0.55);
        margin-bottom: 0.6rem;
    }

    .field-input,
    .field-select {
        width: 100%;
        background: rgba(0,0,0,0.35);
        border: 2px solid rgba(251,191,36,0.18);
        border-radius: 14px;
        color: #e2e8f0;
        font-size: 1rem;
        padding: 14px 16px;
        transition: all 0.35s ease;
        outline: none;
        font-family: inherit;
    }

        .field-input:hover, .field-select:hover {
            border-color: rgba(251,191,36,0.35);
        }

        .field-input:focus, .field-select:focus {
            border-color: var(--gold);
            background: rgba(251,191,36,0.07);
            box-shadow: 0 0 0 3px rgba(251,191,36,0.12), 0 8px 20px rgba(251,191,36,0.12);
            transform: translateY(-1px);
            color: white;
        }

        /* Added readonly style */
        .field-input:read-only {
            background: rgba(251,191,36,0.05);
            border-color: rgba(251,191,36,0.1);
            cursor: not-allowed;
            color: #94a3b8;
        }

        .field-select option {
            background: #0f172a;
            color: #e2e8f0;
        }

    .field-error {
        color: #f87171;
        font-size: 0.8rem;
        margin-top: 6px;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(251,191,36,0.1);
    }

    .btn-submit {
        flex: 1;
        padding: 15px;
        background: linear-gradient(135deg, #d97706, #fbbf24);
        border: none;
        border-radius: 16px;
        color: #1c1008;
        font-size: 1rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        cursor: pointer;
        transition: all 0.4s ease;
        box-shadow: 0 8px 25px rgba(217,119,6,0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        position: relative;
        overflow: hidden;
    }

        .btn-submit::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            transition: left 0.6s;
        }

        .btn-submit:hover::before {
            left: 100%;
        }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(217,119,6,0.5);
        }

    .btn-back {
        padding: 15px 26px;
        background: rgba(251,191,36,0.08);
        border: 1px solid var(--gold-border);
        border-radius: 16px;
        color: var(--gold);
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-back:hover {
            background: rgba(251,191,36,0.16);
            transform: translateY(-2px);
            color: var(--gold);
            text-decoration: none;
        }

    @@keyframes slideDown {
        to

    {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>

<link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@300;600;700;900&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="purchase-form-page">
    <div class="container">

        <div class="form-header">
            <div class="form-icon-wrap">🛒</div>
            <h1 class="form-title">New Purchase</h1>
            <p class="form-subtitle">Record a new vehicle purchase transaction</p>
        </div>

        <div class="form-card">
            <div class="card-top-bar"></div>
            <div class="card-body-inner">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="val-summary">
                        <strong><i class="bi bi-exclamation-triangle me-2"></i>Please fix the errors below:</strong>
                        <ul class="mt-2">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-section">
                        <div class="section-title"><i class="bi bi-person-badge-fill"></i> Seller Information</div>
                        <div class="field-group">
                            <label class="field-label" asp-for="SellerName">Seller Name</label>
                            <input type="text" class="field-input" asp-for="SellerName" value="Motorak" readonly />
                            <span asp-validation-for="SellerName" class="field-error"></span>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="section-title"><i class="bi bi-credit-card-2-front-fill"></i> Payment Details</div>
                        <div class="field-row">
                            <div class="field-group">
                                <label class="field-label" asp-for="PaymentMethod">Payment Method</label>
                                <select class="field-select" asp-for="PaymentMethod">
                                    <option value="">— Select method —</option>
                                    <option value="Cash">Cash</option>
                                    <option value="Credit Card">Credit Card</option>
                                    <option value="Debit Card">Debit Card</option>
                                    <option value="Bank Transfer">Bank Transfer</option>
                                    <option value="Installment">Installment</option>
                                    <option value="Online">Online Payment</option>
                                </select>
                                <span asp-validation-for="PaymentMethod" class="field-error"></span>
                            </div>
                            <div class="field-group">
                                <label class="field-label" asp-for="TotalPrice">Total Price ($)</label>
                                <input type="number" step="0.01" class="field-input" asp-for="TotalPrice" placeholder="0.00" min="0" />
                                <span asp-validation-for="TotalPrice" class="field-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="section-title"><i class="bi bi-link-45deg"></i> Assignment</div>
                        <div class="field-row">
                            <div class="field-group">
                                <label class="field-label" asp-for="CustomerId">Customer</label>
                                <select class="field-select" asp-for="CustomerId" asp-items="@(ViewBag.Customers as SelectList)">
                                    <option value="">— Select customer —</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="field-error"></span>
                            </div>
                            <div class="field-group">
                                <label class="field-label">Car</label>
                                @if (Model.CarId > 0)
                                {
                                    <input type="hidden" asp-for="CarId" />
                                    <input type="text" class="field-input" value="@ViewBag.CarDisplay" readonly />
                                    <small class="text-muted">Car ID: @Model.CarId</small>
                                }
                                else
                                {
                                    <input type="number" class="field-input" asp-for="CarId" placeholder="Enter Car ID" min="1" />
                                }
                                <span asp-validation-for="CarId" class="field-error"></span>
                            </div>
                        </div>

                        <div class="field-group">
                            <label class="field-label" asp-for="Status">Status</label>
                            <select class="field-select" asp-for="Status" asp-items="Html.GetEnumSelectList<Motorak.DAL.Enums.TransactionEnums.TransactionStatus>()">
                                <option value="">— Select status —</option>
                            </select>
                            <span asp-validation-for="Status" class="field-error"></span>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a asp-action="Index" class="btn-back"><i class="bi bi-arrow-left"></i> Back</a>
                        <button type="submit" class="btn-submit">
                            <i class="bi bi-bag-check-fill"></i> Create Purchase
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}