@using Motorak.BLL.ModelVM.Purchases
@using Motorak.DAL.Enums.TransactionEnums
@model PurchaseUpdateDto

@{
    ViewData["Title"] = "Update Transaction";
    Layout = "_MotorakIndex";
}

<link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@300;400;700;900&display=swap" rel="stylesheet">

<style>
    :root {
        --gold-glow: #fbbf24;
        --gold-dark: #d97706;
        --glass-panel: rgba(15, 23, 42, 0.85);
        --accent-emerald: #10b981;
        --accent-rose: #f43f5e;
    }

    .edit-page {
        font-family: 'Exo 2', sans-serif;
        min-height: 100vh;
        padding: 5rem 1rem;
        background: radial-gradient(circle at 50% 0%, rgba(251, 191, 36, 0.05) 0%, transparent 70%);
    }

    /* --- THE 3D FORM CARD --- */
    .form-card-3d {
        background: var(--glass-panel);
        backdrop-filter: blur(30px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 40px;
        padding: 3.5rem;
        box-shadow: 0 50px 100px rgba(0,0,0,0.6), inset 0 1px 1px rgba(255,255,255,0.1);
        max-width: 650px;
        margin: 0 auto;
        position: relative;
        overflow: hidden;
    }

        .form-card-3d::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 6px;
            background: linear-gradient(90deg, transparent, var(--gold-glow), transparent);
        }

    /* --- TACTILE INPUTS --- */
    .input-wrapper {
        margin-bottom: 2rem;
    }

    .label-3d {
        display: block;
        font-weight: 800;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--gold-glow);
        margin-bottom: 12px;
        padding-left: 5px;
    }

    .custom-input-3d {
        background: rgba(0,0,0,0.4) !important;
        border: 1px solid rgba(255,255,255,0.05) !important;
        border-radius: 18px !important;
        color: #fff !important;
        padding: 18px 22px !important;
        font-weight: 600;
        box-shadow: inset 4px 4px 10px rgba(0,0,0,0.5);
        transition: all 0.3s ease;
    }

        .custom-input-3d:focus {
            border-color: var(--gold-glow) !important;
            box-shadow: inset 2px 2px 5px rgba(0,0,0,0.8), 0 0 15px rgba(251,191,36,0.15);
            transform: translateY(-1px);
        }

    /* --- THE STATUS SWITCHES --- */
    .status-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
    }

    .status-switch {
        padding: 20px 10px;
        border-radius: 20px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.4);
        cursor: pointer;
        text-align: center;
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 6px 0 rgba(0,0,0,0.3);
    }

        .status-switch:hover {
            background: rgba(255,255,255,0.07);
            color: #fff;
            transform: translateY(-2px);
        }

        /* Active States with Glow */
        .status-switch.active.sel-pending {
            background: var(--gold-glow);
            color: #000;
            border-color: var(--gold-glow);
            box-shadow: 0 0 25px rgba(251,191,36,0.4), 0 6px 0 var(--gold-dark);
        }

        .status-switch.active.sel-completed {
            background: var(--accent-emerald);
            color: #fff;
            border-color: var(--accent-emerald);
            box-shadow: 0 0 25px rgba(16,185,129,0.4), 0 6px 0 #065f46;
        }

        .status-switch.active.sel-cancelled {
            background: var(--accent-rose);
            color: #fff;
            border-color: var(--accent-rose);
            box-shadow: 0 0 25px rgba(244,63,94,0.4), 0 6px 0 #9f1239;
        }

        .status-switch:active {
            transform: translateY(4px);
            box-shadow: none !important;
        }

    /* --- ACTION BUTTONS --- */
    .btn-save-3d {
        background: linear-gradient(135deg, var(--gold-glow), var(--gold-dark));
        color: #000;
        padding: 18px;
        border-radius: 20px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 2px;
        border: none;
        box-shadow: 0 10px 20px rgba(217,119,6,0.3), inset 0 -4px 0 rgba(0,0,0,0.2);
        transition: 0.3s;
    }

        .btn-save-3d:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(217,119,6,0.4);
        }

    .btn-abort {
        background: rgba(255,255,255,0.05);
        color: rgba(255,255,255,0.6);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 20px;
        padding: 18px 30px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.3s;
    }

        .btn-abort:hover {
            background: rgba(255,255,255,0.1);
            color: #fff;
        }

</style>

<div class="edit-page">
    <div class="container">
        <div class="form-card-3d">

            <div class="text-center mb-5">
                <span class="text-white-50 small fw-bold text-uppercase letter-spacing-2">Secure Update Protocol</span>
                <h2 class="text-white fw-900 display-6 mt-2">Modify Record #@Model.Id</h2>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Status" id="statusHidden" />

                <div class="row">
                    <div class="col-md-12 input-wrapper">
                        <label class="label-3d">Transfer Method</label>
                        <select asp-for="PaymentMethod" class="form-select custom-input-3d">
                            <option value="Cash">Physical Cash</option>
                            <option value="Online">Digital Transfer</option>
                        </select>
                    </div>

                    <div class="col-md-12 input-wrapper">
                        <label class="label-3d">Settlement Amount ($)</label>
                        <input asp-for="TotalPrice" type="number" step="0.01" class="form-control custom-input-3d" placeholder="0.00" />
                        <span asp-validation-for="TotalPrice" class="text-danger small mt-2 d-block"></span>
                    </div>

                    <div class="col-md-12 input-wrapper mt-2">
                        <label class="label-3d">Operational Status</label>
                        <div class="status-grid">
                            <div class="status-switch @(Model.Status == TransactionStatus.Pending ? "active sel-pending" : "")"
                                 onclick="updateSt(0, this, 'sel-pending')">
                                <i class="bi bi-hourglass-split d-block mb-1 fs-5"></i> Pending
                            </div>
                            <div class="status-switch @(Model.Status == TransactionStatus.Completed ? "active sel-completed" : "")"
                                 onclick="updateSt(1, this, 'sel-completed')">
                                <i class="bi bi-check-all d-block mb-1 fs-5"></i> Success
                            </div>
                            <div class="status-switch @(Model.Status == TransactionStatus.Cancelled ? "active sel-cancelled" : "")"
                                 onclick="updateSt(2, this, 'sel-cancelled')">
                                <i class="bi bi-shield-x d-block mb-1 fs-5"></i> Revoked
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="btn-save-3d w-100">
                        Commit Changes
                    </button>
                    <a asp-action="Index" class="btn-abort">
                        Abort
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateSt(val, el, cls) {
            // Remove all active classes
            document.querySelectorAll('.status-switch').forEach(b => {
                b.classList.remove('active', 'sel-pending', 'sel-completed', 'sel-cancelled');
            });

            // Add active class to clicked
            el.classList.add('active', cls);

            // Update hidden input
            document.getElementById('statusHidden').value = val;
        }
    </script>
}