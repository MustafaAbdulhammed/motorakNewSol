@using Motorak.BLL.ModelVM.Purchases
@using Motorak.DAL.Enums.TransactionEnums
@model IEnumerable<PurchaseReadDto>

@{
    ViewData["Title"] = "Transaction Registry";
    Layout = "_MotorakIndex";
}

<link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@300;400;700;900&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<style>
    :root {
        --gold-glow: #fbbf24;
        --gold-dark: #d97706;
        --glass-panel: rgba(15, 23, 42, 0.92); /* Darkened for better text visibility */
        --accent-emerald: #10b981;
        --accent-rose: #f43f5e;
    }

    .purchase-page {
        font-family: 'Exo 2', sans-serif;
        min-height: 100vh;
        padding: 4rem 2rem;
        background: radial-gradient(circle at 50% 0%, rgba(251, 191, 36, 0.08) 0%, transparent 70%);
        color: #fff;
    }

    /* --- TOP NAVIGATION BAR --- */
    .registry-nav {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 4rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding-bottom: 1.5rem;
    }

    .header-text-group h1 {
        font-weight: 900;
        font-size: 3rem;
        letter-spacing: -1px;
        margin: 0;
        background: linear-gradient(to bottom, #fff 40%, var(--gold-glow));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-transform: uppercase;
    }

    .btn-create-master {
        background: linear-gradient(135deg, var(--gold-glow), var(--gold-dark));
        color: #000 !important;
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 800;
        text-decoration: none;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: 0.3s;
        box-shadow: 0 10px 20px rgba(217, 119, 6, 0.2);
    }

    /* --- CARD GRID --- */
    .purchase-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
        gap: 2.5rem;
    }

    .motorak-card {
        background: var(--glass-panel);
        backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 2rem;
        position: relative;
        transition: transform 0.3s ease, border-color 0.3s ease;
    }

        .motorak-card:hover {
            transform: translateY(-10px);
            border-color: var(--gold-glow);
        }

    /* --- CAR IDENTITY --- */
    .car-info-header {
        margin-bottom: 1.5rem;
    }

    .car-display-name {
        font-size: 1.8rem;
        font-weight: 900;
        color: #fff;
        display: block;
        line-height: 1.2;
        margin-top: 4px;
    }

    .status-badge-3d {
        position: absolute;
        top: 20px;
        right: 20px;
        padding: 6px 14px;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .st-completed {
        background: var(--accent-emerald);
        color: white;
    }

    .st-pending {
        background: var(--gold-glow);
        color: #000;
    }

    .st-cancelled {
        background: var(--accent-rose);
        color: white;
    }

    .data-plate {
        background: rgba(0,0,0,0.4);
        border-radius: 18px;
        padding: 1.2rem;
        margin-bottom: 1.5rem;
        border: 1px solid rgba(255,255,255,0.05);
    }

    .label-muted {
        font-size: 0.65rem;
        color: rgba(255,255,255,0.4);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        display: block;
    }

    .price-display {
        font-size: 2rem;
        font-weight: 900;
        color: var(--gold-glow);
    }

    /* --- ACTION BUTTONS WITH NAMES --- */
    .action-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px;
    }

    .btn-action-label {
        padding: 12px 5px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 800;
        font-size: 0.75rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        transition: 0.2s;
        border: 1px solid transparent;
        text-transform: uppercase;
    }

    .btn-view-style {
        background: rgba(255,255,255,0.05);
        color: #fff;
        border-color: rgba(255,255,255,0.1);
    }

    .btn-edit-style {
        background: rgba(251, 191, 36, 0.1);
        color: var(--gold-glow);
        border-color: rgba(251, 191, 36, 0.2);
    }

    .btn-delete-style {
        background: rgba(244, 63, 94, 0.1);
        color: var(--accent-rose);
        border-color: rgba(244, 63, 94, 0.2);
    }

    .btn-action-label:hover {
        filter: brightness(1.2);
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
    }

    .btn-action-label i {
        font-size: 1.2rem;
    }

</style>

<div class="purchase-page">
    <div class="container">

        <div class="registry-nav">
            <div class="header-text-group">
                <p>Registry Management</p>
                <h1>Purchases</h1>
            </div>
            <a asp-action="Create" class="btn-create-master">
                <i class="bi bi-plus-circle-fill"></i> New Transaction
            </a>
        </div>

        <div class="purchase-grid">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="motorak-card">
                        @{
                            var statusClass = item.Status == TransactionStatus.Completed ? "st-completed" :
                            item.Status == TransactionStatus.Cancelled ? "st-cancelled" : "st-pending";
                        }
                        <div class="status-badge-3d @statusClass">@item.Status</div>

                        <div class="car-info-header">
                            <span class="label-muted">Vehicle Identity</span>
                            <span class="car-display-name">@item.Id</span>
                            <small class="text-white-50">Transaction ID: #@item.Id.ToString("D4")</small>
                        </div>

                        <div class="data-plate">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="label-muted">Total Paid</span>
                                    <div class="price-display">$@item.TotalPrice.ToString("N0")</div>
                                </div>
                                <div class="text-end">
                                    <span class="label-muted">Seller</span>
                                    <span class="text-white fw-bold">@item.SellerName</span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4 px-2">
                            <span class="label-muted">Payment Mode</span>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <i class="bi bi-wallet2 text-warning"></i>
                                <span class="text-white fw-bold">@item.PaymentMethod</span>
                            </div>
                        </div>

                        <div class="action-row">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-action-label btn-view-style">
                                <i class="bi bi-eye-fill"></i>
                                <span>View</span>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action-label btn-edit-style">
                                <i class="bi bi-pencil-square"></i>
                                <span>Edit</span>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action-label btn-delete-style">
                                <i class="bi bi-trash3-fill"></i>
                                <span>Delete</span>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <div class="data-plate py-5">
                        <i class="bi bi-database-dash display-1 text-muted"></i>
                        <h2 class="text-white-50 mt-4">Registry is currently empty</h2>
                    </div>
                </div>
            }
        </div>
    </div>
</div>