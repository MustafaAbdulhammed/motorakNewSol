@using Motorak.BLL.ModelVM.Purchases
@using Motorak.DAL.Enums.TransactionEnums
@model PurchaseReadDto

@{
    ViewData["Title"] = "Transaction Manifest";
    Layout = "_MotorakIndex";
    // Logical mapping for 3D status colors
    string statusClass = Model.Status == TransactionStatus.Completed ? "st-done" :
                         Model.Status == TransactionStatus.Cancelled ? "st-void" : "st-wait";
}

<style>
    .details-container {
        min-height: 90vh;
        display: flex;
        align-items: center;
        padding: 4rem 1rem;
    }

    .glass-panel {
        background: linear-gradient(145deg, rgba(255,255,255,0.05) 0%, rgba(0,0,0,0.5) 100%);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(251, 191, 36, 0.3);
        border-radius: 40px;
        box-shadow: 0 50px 100px rgba(0,0,0,0.8), inset 0 1px 1px rgba(255,255,255,0.1);
        width: 100%;
        max-width: 900px;
        margin: auto;
    }

    .info-plate {
        background: rgba(0,0,0,0.3);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 25px;
        padding: 2rem;
        box-shadow: inset 4px 4px 10px rgba(0,0,0,0.5), 2px 2px 5px rgba(255,255,255,0.02);
    }

    /* Excellent 3D Status Pill */
    .st-pill {
        padding: 10px 25px;
        border-radius: 50px;
        font-weight: 900;
        letter-spacing: 1px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.4), inset 0 -3px 0 rgba(0,0,0,0.2);
    }

    .st-done {
        background: linear-gradient(135deg, #10b981, #064e3b);
        color: white;
    }

    .st-wait {
        background: linear-gradient(135deg, #fbbf24, #92400e);
        color: #000;
    }

    .st-void {
        background: linear-gradient(135deg, #ef4444, #7f1d1d);
        color: white;
    }

    /* Tactical 3D Buttons */
    .btn-3d-gold {
        background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
        border: none;
        color: #1a1a1a;
        font-weight: 900;
        padding: 15px 35px;
        border-radius: 18px;
        box-shadow: 0 15px 30px rgba(217,119,6,0.3), inset 0 -4px 0 rgba(0,0,0,0.2);
        transition: 0.2s;
        text-decoration: none;
    }

        .btn-3d-gold:hover {
            transform: translateY(-3px);
            filter: brightness(1.1);
        }
</style>

<div class="details-container">
    <div class="glass-panel">
        <div class="p-5">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <div>
                    <span class="text-warning fw-bold small">SECURE MANIFEST</span>
                    <h1 class="text-white fw-black display-4">ID: #@Model.Id</h1>
                </div>
                <div class="st-pill @statusClass">@Model.Status.ToString().ToUpper()</div>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <div class="info-plate">
                        <label class="text-muted small fw-bold text-uppercase mb-2 d-block">Vendor / Seller</label>
                        <h3 class="text-white mb-0">@Model.SellerName</h3>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-plate">
                        <label class="text-muted small fw-bold text-uppercase mb-2 d-block">Funding Source</label>
                        <h3 class="text-white mb-0">@Model.PaymentMethod</h3>
                    </div>
                </div>
                <div class="col-12">
                    <div class="info-plate text-center" style="border-bottom: 4px solid #fbbf24;">
                        <label class="text-muted small fw-bold text-uppercase mb-1 d-block">Final Settlement Amount</label>
                        <div class="display-3 text-warning fw-black">$@Model.TotalPrice.ToString("N2")</div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3">
                <a asp-action="Index" class="btn btn-outline-light px-4 rounded-4 d-flex align-items-center">Back to Registry</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-3d-gold ms-auto">Update Transaction</a>
            </div>
        </div>
    </div>
</div>